---
import Layout from '../components/Layout.astro';

const title = "Budget Planner Calculator | 50/30/20 Rule in PKR";
const description = "Split your monthly take-home pay with the 50/30/20 budget rule: rupee amounts for needs, wants and savings, with your own percentages if you prefer.";
const slug = "/budget-planner-calculator/";

const faqs = [
  {
    q: "What is the 50/30/20 budget rule?",
    a: "It splits take-home pay into 50% for needs, 30% for wants, and 20% for savings. On Rs 200,000 a month that is Rs 100,000 for needs, Rs 60,000 for wants, and Rs 40,000 for savings.",
  },
  {
    q: "What counts as a need and what counts as a want?",
    a: "Needs are essentials: rent, food, transport, bills, and minimum loan payments. Wants are choices: eating out, entertainment, subscriptions, and upgrades. A phone is a need; the latest model is a want.",
  },
  {
    q: "Can I change the percentages?",
    a: "Yes. The three percentages are editable and can be anything from 0 to 100, as long as they add up to exactly 100%. If they do not, a warning is shown and no result is given.",
  },
  {
    q: "What if 50% does not cover my needs?",
    a: "Then use your real figures. If rent alone takes 60%, set needs to 60% and reduce wants or savings. The calculator shows what your split means in rupees \u2014 it does not judge whether the split is right.",
  },
  {
    q: "Should savings include extra loan payments?",
    a: "Yes, in this planner extra payments above the minimum count as savings, because they reduce what you owe. Minimum payments count as needs, because you must pay them.",
  },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://pakistan-finance-calculators.pages.dev/budget-planner-calculator/#webapp',
      name: "Budget Planner Calculator",
      url: 'https://pakistan-finance-calculators.pages.dev/budget-planner-calculator/',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      description,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pakistan-finance-calculators.pages.dev/' },
        {
          '@type': 'ListItem',
          position: 2,
          name: "Budget Planner Calculator",
          item: 'https://pakistan-finance-calculators.pages.dev/budget-planner-calculator/',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});

const related = [
  {
    href: "/salary-income-tax-calculator/",
    name: "Salary / Income Tax Calculator",
    desc: "Monthly and annual tax on your salary for 2026-27, using FBR salaried slabs, with take-home pay.",
  },
  {
    href: "/goal-savings-calculator/",
    name: "Goal Savings Calculator",
    desc: "How much to save each month for a target, or how long a monthly saving will take to reach it.",
  },
];
---
<Layout title={title} description={description} slug={slug} schema={schema}>
  <div class="container" style="padding-top: 32px;">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <p style="font-size: 14px; color: var(--ink-muted);"><a href="/">Home</a> / Budget Planner Calculator</p>
    </nav>
    <p class="badge badge-info" style="margin-top: 8px;">Monthly Budget</p>
    <h1 style="font-size: clamp(1.75rem, 4.5vw, 2.25rem); max-width: 720px;">Budget Planner Calculator</h1>
    <p class="prose-narrow" style="font-size: clamp(1.0625rem, 2vw, 1.1875rem); margin-top: 12px;">
      Split your monthly take-home pay into needs, wants, and savings. The classic split is 50% needs, 30% wants, and 20% savings — but you can change the percentages to fit your life, as long as they add up to 100%.
    </p>
    <p class="notice-info prose-narrow" style="margin-top: 16px;">
      <strong>No live data.</strong> Every rate, price, and percentage on this page is entered by
      you. Nothing is fetched from a bank, a market, or a government source, and no figure here
      is presented as a live or official rate.
    </p>
  </div>

  <div class="container" style="margin-top: 20px;">
    <div class="tool-grid">
      <div class="card">
        <form id="budgetForm" novalidate>
          <div class="field">
            <label for="budgetIncome">Monthly take-home pay (Rs) <span aria-hidden="true">*</span></label>
            <input id="budgetIncome" type="text" inputmode="decimal" autocomplete="off" aria-required="true" />
            <p class="hint">What you actually receive each month, after tax and deductions.</p>
          </div>

          <div class="field">
            <label for="budgetNeeds">Needs (%) <span aria-hidden="true">*</span></label>
            <input id="budgetNeeds" type="text" inputmode="decimal" autocomplete="off" aria-required="true" value="50" />
            <p class="hint">Essentials: rent, food, transport, bills, and minimum loan payments.</p>
          </div>

          <div class="field">
            <label for="budgetWants">Wants (%) <span aria-hidden="true">*</span></label>
            <input id="budgetWants" type="text" inputmode="decimal" autocomplete="off" aria-required="true" value="30" />
            <p class="hint">Non-essentials: eating out, entertainment, subscriptions, and upgrades.</p>
          </div>

          <div class="field">
            <label for="budgetSavings">Savings (%) <span aria-hidden="true">*</span></label>
            <input id="budgetSavings" type="text" inputmode="decimal" autocomplete="off" aria-required="true" value="20" />
            <p class="hint">Savings and extra debt payments above the minimum.</p>
          </div>

          <p class="hint" id="budgetSumNote">The three percentages must add up to 100%.</p>

          <div id="budgetErrors" class="error-box" role="alert" hidden></div>

          <p style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin-top: 16px;">
            <button id="budgetCalculate" class="btn-primary" type="submit">Calculate</button>
            <button id="budgetClear" class="btn-secondary" type="button">Clear</button>
          </p>
          <p id="budgetFormStatus" role="status" style="font-size: 14px; color: var(--ink-muted);"></p>
        </form>
      </div>

      <div class="result-card" id="budgetResultCard" tabindex="-1">
        <div id="budgetEmpty">
          <p style="font-weight: 700;">Your result will appear here.</p>
          <p>Enter your details to see your result.</p>
          <p style="font-size: 14px; color: var(--ink-muted);">
            You will see your answer with the figures shown, so you can check it.
          </p>
        </div>

        <div id="budgetResult" data-result-text hidden>
          <p style="font-size: 14px; font-weight: 700; color: var(--ink-muted);">Result</p>
          <div aria-live="polite" aria-atomic="true">
            <p class="result-value" id="budgetHeadline"></p>
          </div>
          <div class="stat-grid">
            <div>
              <p class="stat-label">Wants</p>
              <p class="stat-value" id="budgetStat1"></p>
            </div>
            <div>
              <p class="stat-label">Savings</p>
              <p class="stat-value" id="budgetStat2"></p>
            </div>
            <div>
              <p class="stat-label">Take-home pay (total)</p>
              <p class="stat-value" id="budgetStat3"></p>
            </div>
          </div>
          <p id="budgetEcho" style="font-size: 14px; color: var(--ink-muted);"></p>
          <p id="budgetFormula" style="font-size: 16px;"></p>
          <p style="font-size: 13px; color: var(--ink-muted);">
            Estimate only — check important figures before acting.
            <a href="#budgetDisclaimer">Read the full disclaimer.</a>
          </p>
        </div>

        <div class="actions-row no-print">
          <button type="button" class="btn-secondary" data-copy-result disabled>Copy result</button>
          <button type="button" class="btn-secondary" data-print-result disabled>Print</button>
        </div>
        <p data-copy-status role="status" style="font-size: 14px;"></p>
      </div>
    </div>
  </div>

  <div class="container prose-narrow" style="margin-top: 40px;">
    <h2>How it works</h2>
    <ol>
      <li>Enter your monthly take-home pay — what you actually receive, after tax and deductions.</li>
      <li>Set the three percentages. The defaults are 50% needs, 30% wants, and 20% savings. Change them if your rent or other essentials take a larger share.</li>
      <li>You see the rupee amount for each category. If the percentages do not add up to 100%, a clear warning is shown and no result is given.</li>
    </ol>
    <p>Needs are essentials you cannot skip: rent, food, transport, bills, and minimum loan payments. Wants are choices: eating out, entertainment, subscriptions, and upgrades. Savings includes money set aside and any extra debt payments above the minimum.</p>

    <h2>Formula</h2>
    <p>Needs amount = Take-home pay × Needs %</p>
    <p>Wants amount = Take-home pay × Wants %</p>
    <p>Savings amount = Take-home pay × Savings %</p>
    <p>Needs % + Wants % + Savings % must equal 100%. To check your pay after tax first, use the <a href="/salary-income-tax-calculator/">Salary / Income Tax Calculator</a>.</p>

    <h2>Worked example</h2>
    <p><strong>Example:</strong> Take-home pay Rs 200,000 a month at 50/30/20 gives Rs 100,000 for needs, Rs 60,000 for wants, and Rs 40,000 for savings. The three amounts add up to Rs 200,000.</p>

    <h2>Frequently asked questions</h2>
    <div class="faq">
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
    <p>Still have a question? <a href="/contact/">Contact us</a>.</p>

    <section id="budgetDisclaimer" class="notice-info" style="margin-top: 32px;">
      <h2 style="font-size: 20px;">Important — please read</h2>
      <p>
        This is a planning aid, not financial advice. The 50/30/20 split is a guideline, not a rule that fits everyone — high rent or low income may make it impossible, and that is not a personal failure. Adjust the split to your real costs and priorities.
      </p>
      <p><a href="/terms/">Read the full Terms &amp; Disclaimer</a>.</p>
    </section>

    <h2 style="margin-top: 32px;">Related tools</h2>
    <div class="related-grid">
      {
        related.map((tool) => (
          <article class="card">
            <h3 style="font-size: 18px;">
              <a href={tool.href}>{tool.name}</a>
            </h3>
            <p style="color: var(--ink-muted);">{tool.desc}</p>
            <p>
              <a href={tool.href}>Use the calculator →</a>
            </p>
          </article>
        ))
      }
    </div>
  </div>

  <style>
    [hidden] {
      display: none !important;
    }
    .field-error {
      font-size: 14px;
      color: var(--danger);
      font-weight: 600;
    }
    .stat-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 16px;
      margin: 12px 0;
    }
    .stat-grid p {
      margin: 0;
    }
    .stat-label {
      font-size: 14px;
      color: var(--ink-muted);
    }
    .stat-value {
      font-size: 20px;
      font-weight: 700;
    }
    .actions-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 16px;
    }
    .related-grid {
      display: grid;
      gap: 16px;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  </style>

  <script>
    import { calcBudget, parseDecimal, formatPKR, formatNumber } from '../lib/calc.ts';

    const form = document.getElementById('budgetForm');
    const errorsBox = document.getElementById('budgetErrors');
    const emptyBox = document.getElementById('budgetEmpty');
    const resultBox = document.getElementById('budgetResult');
    const resultCard = document.getElementById('budgetResultCard');
    const headline = document.getElementById('budgetHeadline');
    const stat1 = document.getElementById('budgetStat1');
    const stat2 = document.getElementById('budgetStat2');
    const stat3 = document.getElementById('budgetStat3');
    const echoEl = document.getElementById('budgetEcho');
    const formulaEl = document.getElementById('budgetFormula');
    const copyBtn = document.querySelector('[data-copy-result]');
    const printBtn = document.querySelector('[data-print-result]');
    const formStatus = document.getElementById('budgetFormStatus');

    function readNumber(id, label) {
      const raw = document.getElementById(id).value;
      if (raw.trim() === '') throw new Error(label + ' is required.');
      const value = parseDecimal(raw);
      if (value === null) throw new Error(label + ' must be a number using digits and one decimal point only.');
      return value;
    }
    function showEmpty() {
      resultBox.hidden = true;
      emptyBox.hidden = false;
      copyBtn.disabled = true;
      printBtn.disabled = true;
    }
    function showResult() {
      emptyBox.hidden = true;
      resultBox.hidden = false;
      copyBtn.disabled = false;
      printBtn.disabled = false;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      try {
        const income = readNumber('budgetIncome', 'Monthly take-home pay');
        const needs = readNumber('budgetNeeds', 'Needs percentage');
        const wants = readNumber('budgetWants', 'Wants percentage');
        const savings = readNumber('budgetSavings', 'Savings percentage');
        const r = calcBudget(income, needs, wants, savings);
        errorsBox.textContent = '';
        errorsBox.hidden = true;
        headline.textContent = formatPKR(r.needs, 2);
        stat1.textContent = formatPKR(r.wants, 2);
        stat2.textContent = formatPKR(r.savings, 2);
        stat3.textContent = formatPKR(r.total, 2);
        echoEl.textContent = 'Based on: take-home pay ' + formatPKR(income, 2) + ' per month, split ' + formatNumber(needs, 2) + '% needs / ' + formatNumber(wants, 2) + '% wants / ' + formatNumber(savings, 2) + '% savings.';
        formulaEl.textContent = 'Needs = ' + formatNumber(needs, 2) + '% of ' + formatPKR(income, 2) + ' = ' + formatPKR(r.needs, 2) + '. Wants = ' + formatNumber(wants, 2) + '% = ' + formatPKR(r.wants, 2) + '. Savings = ' + formatNumber(savings, 2) + '% = ' + formatPKR(r.savings, 2) + '. The three amounts add up to your take-home pay.';
        showResult();
        if (window.matchMedia('(max-width: 899px)').matches) resultCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (err) {
        errorsBox.textContent = err.message;
        errorsBox.hidden = false;
        showEmpty();
      }
    });

    document.getElementById('budgetClear').addEventListener('click', () => {
      form.reset();
      errorsBox.textContent = '';
      errorsBox.hidden = true;
      formStatus.textContent = 'Form cleared.';
      showEmpty();
    });
    showEmpty();

  </script>
</Layout>
