---
import Layout from '../components/Layout.astro';

const title = "Fixed Deposit Calculator | Maturity & Profit in PKR";
const description = "Work out the maturity amount and profit on a fixed deposit: the profit before and after the withholding tax you enter, at the rate and tenure you choose.";
const slug = "/fixed-deposit-calculator/";

const faqs = [
  {
    q: "What is the difference between compounding and simple profit?",
    a: "With compounding, profit is added to the balance and later profit is worked out on the larger amount, so it grows faster. With simple profit, profit is worked out on the original deposit only, for the whole tenure.",
  },
  {
    q: "Which compounding option should I choose?",
    a: "Choose the one that matches the bank's offer: how often it adds profit to the account. If the bank pays profit out instead of adding it, use the simple profit option, paid at maturity.",
  },
  {
    q: "Is the withholding tax rate the real tax rate?",
    a: "No. The tax field is your input, defaulting to 0. Tax rules depend on the depositor and the current law, so enter the rate that applies to you, or 0 to see the profit before tax.",
  },
  {
    q: "Why is the maturity amount higher with monthly compounding?",
    a: "Because profit is added more often, so each later period earns profit on a slightly larger balance. At the same annual rate, monthly compounding gives a little more than quarterly, which gives a little more than annual.",
  },
  {
    q: "Does the calculator know any bank's rate?",
    a: "No. Every rate on this page is entered by you. No bank, product, or rate is named, and nothing here is an offer from any bank.",
  },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://pakistan-finance-calculators.pages.dev/fixed-deposit-calculator/#webapp',
      name: "Fixed Deposit Calculator",
      url: 'https://pakistan-finance-calculators.pages.dev/fixed-deposit-calculator/',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      description,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pakistan-finance-calculators.pages.dev/' },
        {
          '@type': 'ListItem',
          position: 2,
          name: "Fixed Deposit Calculator",
          item: 'https://pakistan-finance-calculators.pages.dev/fixed-deposit-calculator/',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});

const related = [
  {
    href: "/compound-interest-calculator/",
    name: "Compound Interest Calculator",
    desc: "How savings grow with compound interest, with a year-by-year table, from the figures you enter.",
  },
  {
    href: "/inflation-calculator/",
    name: "Inflation Calculator",
    desc: "The future cost of an amount and its purchasing power, at the inflation rate and years you assume.",
  },
];
---
<Layout title={title} description={description} slug={slug} schema={schema}>
  <div class="container" style="padding-top: 32px;">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <p style="font-size: 14px; color: var(--ink-muted);"><a href="/">Home</a> / Fixed Deposit Calculator</p>
    </nav>
    <p class="badge badge-info" style="margin-top: 8px;">Savings & Growth</p>
    <h1 style="font-size: clamp(1.75rem, 4.5vw, 2.25rem); max-width: 720px;">Fixed Deposit Calculator</h1>
    <p class="prose-narrow" style="font-size: clamp(1.0625rem, 2vw, 1.1875rem); margin-top: 12px;">
      Work out what a fixed deposit will be worth at maturity. Enter the deposit amount, the profit rate a bank quotes you, how long it runs, and how the profit is worked out — and see the maturity amount and the profit before and after the tax rate you enter.
    </p>
    <p class="notice-info prose-narrow" style="margin-top: 16px;">
      <strong>No live data.</strong> Every rate, price, and percentage on this page is entered by
      you. Nothing is fetched from a bank, a market, or a government source, and no figure here
      is presented as a live or official rate.
    </p>
  </div>

  <div class="container" style="margin-top: 20px;">
    <div class="tool-grid">
      <div class="card">
        <form id="fdForm" novalidate>
          <div class="field">
            <label for="fdPrincipal">Deposit amount (Rs) <span aria-hidden="true">*</span></label>
            <input id="fdPrincipal" type="text" inputmode="decimal" autocomplete="off" aria-required="true" />
            <p class="hint">The amount you place on fixed deposit.</p>
          </div>

          <div class="field">
            <label for="fdRate">Annual profit rate (%) <span aria-hidden="true">*</span></label>
            <input id="fdRate" type="text" inputmode="decimal" autocomplete="off" aria-required="true" />
            <p class="hint">The yearly profit rate you assume. Enter the rate a bank quotes you — no bank's actual rate is used.</p>
          </div>

          <div class="field">
            <label for="fdYears">Tenure (years) <span aria-hidden="true">*</span></label>
            <input id="fdYears" type="text" inputmode="decimal" autocomplete="off" aria-required="true" />
            <p class="hint">How long the deposit runs, from just above 0 to 30 years. Part years are allowed.</p>
          </div>

          <div class="field">
            <label for="fdCompounding">Profit payment / compounding</label>
            <select id="fdCompounding">
              <option value="monthly">Monthly compounding</option>
              <option value="quarterly" selected>Quarterly compounding</option>
              <option value="annual">Annual compounding</option>
              <option value="maturity">Simple profit, paid at maturity</option>
            </select>
            <p class="hint">How the profit is worked out. Compounding adds profit to the balance so later profit is worked out on more; simple profit is worked out on the original deposit only.</p>
          </div>

          <div class="field">
            <label for="fdTax">Withholding tax on profit (%)</label>
            <input id="fdTax" type="text" inputmode="decimal" autocomplete="off" value="0" />
            <p class="hint">The tax rate you enter yourself, applied to the profit only. Enter 0 if you do not want tax shown. This is your input, not a tax rule.</p>
          </div>

          <div id="fdErrors" class="error-box" role="alert" hidden></div>

          <p style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin-top: 16px;">
            <button id="fdCalculate" class="btn-primary" type="submit">Calculate</button>
            <button id="fdClear" class="btn-secondary" type="button">Clear</button>
          </p>
          <p id="fdFormStatus" role="status" style="font-size: 14px; color: var(--ink-muted);"></p>
        </form>
      </div>

      <div class="result-card" id="fdResultCard" tabindex="-1">
        <div id="fdEmpty">
          <p style="font-weight: 700;">Your result will appear here.</p>
          <p>Enter your details to see your result.</p>
          <p style="font-size: 14px; color: var(--ink-muted);">
            You will see your answer with the figures shown, so you can check it.
          </p>
        </div>

        <div id="fdResult" data-result-text hidden>
          <p style="font-size: 14px; font-weight: 700; color: var(--ink-muted);">Result</p>
          <div aria-live="polite" aria-atomic="true">
            <p class="result-value" id="fdHeadline"></p>
          </div>
          <div class="stat-grid">
            <div>
              <p class="stat-label">Profit before tax</p>
              <p class="stat-value" id="fdStat1"></p>
            </div>
            <div>
              <p class="stat-label">Tax on profit (your rate)</p>
              <p class="stat-value" id="fdStat2"></p>
            </div>
            <div>
              <p class="stat-label">Profit after tax</p>
              <p class="stat-value" id="fdStat3"></p>
            </div>
          </div>
          <p id="fdEcho" style="font-size: 14px; color: var(--ink-muted);"></p>
          <p id="fdFormula" style="font-size: 16px;"></p>
          <p style="font-size: 13px; color: var(--ink-muted);">
            Estimate only — check important figures before acting.
            <a href="#fdDisclaimer">Read the full disclaimer.</a>
          </p>
        </div>

        <div class="actions-row no-print">
          <button type="button" class="btn-secondary" data-copy-result disabled>Copy result</button>
          <button type="button" class="btn-secondary" data-print-result disabled>Print</button>
        </div>
        <p data-copy-status role="status" style="font-size: 14px;"></p>
      </div>
    </div>
  </div>

  <div class="container prose-narrow" style="margin-top: 40px;">
    <h2>How it works</h2>
    <ol>
      <li>Enter the deposit amount, the annual profit rate, and the tenure in years.</li>
      <li>Choose how profit is worked out: monthly, quarterly, or annual compounding, or simple profit paid at maturity.</li>
      <li>Enter the withholding-tax rate you want applied to the profit, or leave it at 0. You see the maturity amount, the profit before tax, the tax, and the profit after tax.</li>
    </ol>
    <p>No bank's actual rate is used anywhere on this page. Banks quote different rates for different tenures and amounts, and rates change — always enter the rate from the bank's current offer, and read its terms.</p>

    <h2>Formula</h2>
    <p>Compounded: Maturity amount = Deposit × (1 + annual rate ÷ periods per year)<sup>periods per year × years</sup></p>
    <p>Simple (at maturity): Maturity amount = Deposit × (1 + annual rate × years)</p>
    <p>Profit = Maturity amount − Deposit. Tax = Profit × withholding-tax %. Profit after tax = Profit − Tax.</p>

    <h2>Worked example</h2>
    <p><strong>Example:</strong> Rs 500,000 at 12% a year for 3 years, compounded quarterly, grows to Rs 712,880.44. The profit is Rs 212,880.44. At a 15% withholding-tax rate entered by the user, the tax is Rs 31,932.07 and the profit after tax is Rs 180,948.37. The same deposit with simple profit paid at maturity would reach Rs 680,000, a profit of Rs 180,000 before tax.</p>

    <h2>Frequently asked questions</h2>
    <div class="faq">
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
    <p>Still have a question? <a href="/contact/">Contact us</a>.</p>

    <section id="fdDisclaimer" class="notice-info" style="margin-top: 32px;">
      <h2 style="font-size: 20px;">Important — please read</h2>
      <p>
        Results are estimates from the rate, tenure, and tax rate you enter. No bank's actual rate is stated or implied, and the tax rate is your input, not a statement of current tax law. Real deposits may have minimum amounts, early-withdrawal penalties, and different profit-payment terms. Confirm the offer and the tax treatment with the bank.
      </p>
      <p><a href="/terms/">Read the full Terms &amp; Disclaimer</a>.</p>
    </section>

    <h2 style="margin-top: 32px;">Related tools</h2>
    <div class="related-grid">
      {
        related.map((tool) => (
          <article class="card">
            <h3 style="font-size: 18px;">
              <a href={tool.href}>{tool.name}</a>
            </h3>
            <p style="color: var(--ink-muted);">{tool.desc}</p>
            <p>
              <a href={tool.href}>Use the calculator →</a>
            </p>
          </article>
        ))
      }
    </div>
  </div>

  <style>
    [hidden] {
      display: none !important;
    }
    .field-error {
      font-size: 14px;
      color: var(--danger);
      font-weight: 600;
    }
    .stat-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 16px;
      margin: 12px 0;
    }
    .stat-grid p {
      margin: 0;
    }
    .stat-label {
      font-size: 14px;
      color: var(--ink-muted);
    }
    .stat-value {
      font-size: 20px;
      font-weight: 700;
    }
    .actions-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 16px;
    }
    .related-grid {
      display: grid;
      gap: 16px;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  </style>

  <script>
    import { calcFixedDeposit, parseDecimal, formatPKR, formatNumber } from '../lib/calc.ts';

    const form = document.getElementById('fdForm');
    const errorsBox = document.getElementById('fdErrors');
    const emptyBox = document.getElementById('fdEmpty');
    const resultBox = document.getElementById('fdResult');
    const resultCard = document.getElementById('fdResultCard');
    const headline = document.getElementById('fdHeadline');
    const stat1 = document.getElementById('fdStat1');
    const stat2 = document.getElementById('fdStat2');
    const stat3 = document.getElementById('fdStat3');
    const echoEl = document.getElementById('fdEcho');
    const formulaEl = document.getElementById('fdFormula');
    const copyBtn = document.querySelector('[data-copy-result]');
    const printBtn = document.querySelector('[data-print-result]');
    const formStatus = document.getElementById('fdFormStatus');

    function readNumber(id, label, allowBlankZero) {
      const raw = document.getElementById(id).value;
      if (raw.trim() === '') {
        if (allowBlankZero) return 0;
        throw new Error(label + ' is required.');
      }
      const value = parseDecimal(raw);
      if (value === null) throw new Error(label + ' must be a number using digits and one decimal point only.');
      return value;
    }
    function showEmpty() {
      resultBox.hidden = true;
      emptyBox.hidden = false;
      copyBtn.disabled = true;
      printBtn.disabled = true;
    }
    function showResult() {
      emptyBox.hidden = true;
      resultBox.hidden = false;
      copyBtn.disabled = false;
      printBtn.disabled = false;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      try {
        const principal = readNumber('fdPrincipal', 'Deposit amount', false);
        const rate = readNumber('fdRate', 'Annual profit rate', false);
        const years = readNumber('fdYears', 'Tenure', false);
        const compounding = document.getElementById('fdCompounding').value;
        const tax = readNumber('fdTax', 'Withholding tax', true);
        const r = calcFixedDeposit(principal, rate, years, compounding, tax);
        errorsBox.textContent = '';
        errorsBox.hidden = true;
        headline.textContent = formatPKR(r.maturityAmount, 2);
        stat1.textContent = formatPKR(r.profitBeforeTax, 2);
        stat2.textContent = formatPKR(r.taxAmount, 2);
        stat3.textContent = formatPKR(r.profitAfterTax, 2);
        const compLabel = document.getElementById('fdCompounding').selectedOptions[0].textContent;
        echoEl.textContent = 'Based on: deposit ' + formatPKR(principal, 2) + ', profit rate ' + formatNumber(rate, 2) + '% per year, ' + formatNumber(years, 2) + ' years, ' + compLabel.toLowerCase() + ', tax ' + formatNumber(tax, 2) + '% on profit.';
        formulaEl.textContent = 'Maturity amount = deposit grown at the entered rate for the entered tenure. Profit = maturity amount - deposit. Tax = profit x tax %. Profit after tax = profit - tax.';
        showResult();
        if (window.matchMedia('(max-width: 899px)').matches) resultCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (err) {
        errorsBox.textContent = err.message;
        errorsBox.hidden = false;
        showEmpty();
      }
    });

    document.getElementById('fdClear').addEventListener('click', () => {
      form.reset();
      errorsBox.textContent = '';
      errorsBox.hidden = true;
      formStatus.textContent = 'Form cleared.';
      showEmpty();
    });
    showEmpty();

  </script>
</Layout>
