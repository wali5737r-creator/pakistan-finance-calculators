---
import Layout from '../components/Layout.astro';
import '../styles/pages/home-loan-calculator.css';
import {
  APNA_GHAR_HOMES_FY2025_26,
  APNA_GHAR_MAX_FLAT_SQFT,
  APNA_GHAR_MAX_FINANCING,
  APNA_GHAR_MAX_HOUSE_MARLA,
  APNA_GHAR_MIN_AGE_PRIMARY_APPLICANT,
  APNA_GHAR_SUBSIDY_RATE_PCT,
  APNA_GHAR_SUBSIDY_YEARS,
  HOME_LOAN_BANK_SPREADS,
  HOME_LOAN_DEFAULT_EQUITY_PCT,
  HOME_LOAN_DEFAULT_PRICE,
  HOME_LOAN_DEFAULT_PROCESSING_FEE,
  HOME_LOAN_DEFAULT_RATE_PCT,
  HOME_LOAN_DEFAULT_TENURE_YEARS,
  HOME_LOAN_SOURCE_CITATION,
  HOME_LOAN_SOURCE_URL_MCB,
  HOME_LOAN_SOURCE_URL_MCB_FAQ,
  HOME_LOAN_SOURCE_URL_SBP,
} from '../config/home-loan';

const title = "Home Loan Calculator Pakistan | Commercial & Apna Ghar EMI | Pakistan Finance Calculators";
const description = "Work out your home loan EMI in Pakistan: commercial KIBOR-linked rates or the Apna Ghar 5% subsidy for 10 years, with both phases shown. Free and instant.";
const slug = "/home-loan-calculator/";

const faqs = [
  {
    q: "How much down payment do I need for a home loan in Pakistan?",
    a: "On a commercial home loan, typically 15–30% of the property price — banks finance 70–85%. HBL finances up to 70% (30% equity), Meezan 70–75%, Bank Alfalah up to 80% (minimum 20% equity), NBP 85% up to Rs 25m and 75% above, and Bank AL Habib 75–85%. Under the Apna Ghar scheme the bank finances 90%, so you need only 10% equity. SBP allows up to 90% financing as a ceiling, but banks are stricter than the ceiling.",
  },
  {
    q: "How long can a home loan run?",
    a: "Most banks offer up to 25 years (minimum 1–3 years depending on the bank: HBL, Meezan and Bank Alfalah 3–25 years; MCB 2–25; JS 1–25; BankIslami 2–25). SBP allows up to 30 years as a ceiling, but no major bank product was found offering 30 years, so this calculator caps commercial tenure at 25 years. The Apna Ghar scheme caps at 20 years.",
  },
  {
    q: "What is the Apna Ghar scheme, and is Mera Pakistan Mera Ghar still running?",
    a: "Mera Pakistan Mera Ghar ended — it ran from October 2020 and was suspended on 30 June 2022, so its old 2%, 5% and 7% tier rates are obsolete and are not shown here. The live scheme is the Wazir-e-Azam Apna Ghar Program – Ghar Ho Tu Apna (SBP SH&SFD Circular No. 3/2025, 24 September 2025; launched 30 April 2026): up to Rs 10 million, fixed 5% for the first 10 years, then 1-year KIBOR +3%, maximum 20 years, 90% financing, no processing fee and no prepayment penalty — for first-time homeowners only, a house up to 10 marla or a flat up to 1,500 sq ft.",
  },
  {
    q: "Why does the Apna Ghar EMI change after 10 years?",
    a: "Because the 5% rate is a subsidy for the first 10 years only. After that the loan continues at the bank's rate — 1-year KIBOR +3% — on whatever balance is still owed. So the calculator shows two EMIs: the phase-1 EMI for years 1–10 at 5%, and the phase-2 EMI for the remaining years at the post-subsidy rate you enter (default 16%, about KIBOR +3% in November 2026). A single EMI worked out at 5% for the whole 20 years would understate what you pay, and a single EMI at 16% would hide the subsidy.",
  },
  {
    q: "How is the home loan EMI calculated?",
    a: "With the reducing-balance formula: EMI = P x R x (1+R)^N / ((1+R)^N − 1), where P is the financed amount (property price minus your equity), R is the monthly rate (annual markup divided by 100 and by 12), and N is the number of months. In Apna Ghar mode the phase-1 EMI is the EMI that would repay the loan over the full tenure at 5%; after 10 years the remaining balance is re-amortised over the remaining months at the post-subsidy rate, giving the phase-2 EMI.",
  },
  {
    q: "What costs are not in the EMI?",
    a: "Valuation, legal opinion, stamp duty and transfer/mortgage costs are extra and charged at actual cost — no bank publishes typical amounts, so they are not in the calculation. The processing fee (about Rs 10,000 + FED on a commercial loan; Rs 0 under Apna Ghar) is shown separately and added to the total cost. Insurance/Takaful is included in the monthly instalment itself, according to the MCB Apna Ghar FAQ. Total consumer instalments, including this loan, must stay within 65% of net disposable income under SBP rules.",
  },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://pakistan-finance-calculators.pages.dev/home-loan-calculator/#webapp',
      name: "Home Loan Calculator",
      url: 'https://pakistan-finance-calculators.pages.dev/home-loan-calculator/',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      description,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pakistan-finance-calculators.pages.dev/' },
        {
          '@type': 'ListItem',
          position: 2,
          name: "Home Loan Calculator",
          item: 'https://pakistan-finance-calculators.pages.dev/home-loan-calculator/',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});

const related = [
  {
    href: "/emi-loan-calculator/",
    name: "EMI / Loan Calculator",
    desc: "The monthly instalment, total interest and full amortisation schedule for any reducing-balance loan — the same formula this home loan EMI uses.",
  },
  {
    href: "/loan-eligibility-calculator/",
    name: "Loan Eligibility Calculator",
    desc: "Check the largest loan your income can support first — SBP keeps total consumer instalments within 65% of net disposable income.",
  },
  {
    href: "/loan-comparison-calculator/",
    name: "Loan Comparison Calculator",
    desc: "Compare two home-loan offers side by side: EMI, total interest and total payment for each, and which one costs less overall.",
  },
];
---
<Layout title={title} description={description} slug={slug} schema={schema}>
  <div class="container u-pt-32 pg-home-loan-calculator">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <p class="u-muted-14"><a href="/" data-i18n="nav.home">Home</a> / <span data-i18n="home.crumb">Home Loan Calculator</span></p>
    </nav>
    <p class="badge badge-info u-mt-8" data-i18n="loans.badge">Loans</p>
    <h1 data-i18n="home.h1" class="u-hero-title">Home Loan Calculator Pakistan</h1>
    <p class="prose-narrow u-lede" data-i18n="home.intro">
      Work out the monthly EMI on a home loan in Pakistan — as a commercial loan at a
      floating KIBOR-linked rate, or under the Apna Ghar scheme at 5% fixed for the
      first 10 years and then KIBOR +3%. Apna Ghar mode shows both phases' EMIs, so
      the subsidy is never hidden inside a single rate.
    </p>
    <p class="notice-info prose-narrow u-mt-16">
      <strong data-i18n="home.notice-strong">Terms checked 13 November 2026.</strong><span data-i18n="home.notice-pre1"> Commercial home-loan rates are
      floating (KIBOR + a bank spread of about 2–4.25%) and change — the all-in band in
      November 2026 was about </span>14.9–17.2%<span data-i18n="home.notice-post"> per year. The rate on your bank's Key Fact
      Statement / offer letter governs, not this estimate.</span>
    </p>
  </div>

  <div class="container u-mt-20 pg-home-loan-calculator">
    <div class="tool-grid">
      <div class="card">
        <form id="homeForm" novalidate>
          <div class="field">
            <label for="homeMode"><span data-i18n="home.mode-label">Which home loan?</span> <span aria-hidden="true">*</span></label>
            <select id="homeMode" aria-required="true">
              <option value="commercial" selected data-i18n="home.mode-commercial">Commercial — floating KIBOR-linked rate</option>
              <option value="apna-ghar" data-i18n="home.mode-apna">Apna Ghar — 5% fixed for 10 years, then KIBOR +3%</option>
            </select>
            <p class="hint" id="homeModeHint">Commercial: one floating rate for the whole tenure. Apna Ghar: the government-subsidised scheme for first-time homeowners, up to Rs 10m, maximum 20 years.</p>
          </div>

          <div class="field">
            <label for="homePrice"><span data-i18n="home.price-label">Property price (Rs)</span> <span aria-hidden="true">*</span></label>
            <input id="homePrice" type="text" inputmode="decimal" autocomplete="off" value={HOME_LOAN_DEFAULT_PRICE} />
            <p class="hint" data-i18n="home.price-hint">The price of the house or flat. In Apna Ghar mode the financed amount must be Rs 10,000,000 or less, the house at most 10 marla, or the flat at most 1,500 sq ft.</p>
          </div>

          <div class="field">
            <label for="homeEquity"><span data-i18n="home.equity-label">Equity / down payment (%)</span> <span aria-hidden="true">*</span></label>
            <input id="homeEquity" type="text" inputmode="decimal" autocomplete="off" value={HOME_LOAN_DEFAULT_EQUITY_PCT} />
            <p class="hint" id="homeEquityHint">Commercial: 15–30% (banks finance 70–85%). SBP allows up to 90% financing as a ceiling, but banks are stricter.</p>
          </div>

          <div class="field">
            <label for="homeTenure"><span data-i18n="home.tenure-label">Tenure (years)</span> <span aria-hidden="true">*</span></label>
            <input id="homeTenure" type="text" inputmode="numeric" autocomplete="off" value={HOME_LOAN_DEFAULT_TENURE_YEARS} />
            <p class="hint" id="homeTenureHint">Whole years, 3–25 for a commercial loan (banks cap at 25; SBP allows 30). Apna Ghar caps at 20 years.</p>
          </div>

          <div class="field">
            <label for="homeRate" id="homeRateLabel">Markup rate (% per year) <span aria-hidden="true">*</span></label>
            <input id="homeRate" type="text" inputmode="decimal" autocomplete="off" value={HOME_LOAN_DEFAULT_RATE_PCT} />
            <p class="hint" id="homeRateHint">Default 16% — inside the November 2026 commercial band of about 14.9–17.2% (KIBOR + about 3%). Enter the rate your bank quotes you.</p>
          </div>

          <div class="field" id="homePostRateField" hidden>
            <label for="homePostRate"><span data-i18n="home.postrate-label">Post-subsidy rate, years 11 onwards (% per year)</span> <span aria-hidden="true">*</span></label>
            <input id="homePostRate" type="text" inputmode="decimal" autocomplete="off" value="16" />
            <p class="hint" data-i18n="home.postrate-hint">The rate after the 10-year subsidy ends: 1-year KIBOR +3% — about 16% in November 2026. Editable, because KIBOR moves and the rate in year 11 is not known today.</p>
          </div>

          <div class="field" id="homeFeeField">
            <label for="homeFee"><span data-i18n="home.fee-label">Processing fee (Rs, flat)</span> <span aria-hidden="true">*</span></label>
            <input id="homeFee" type="text" inputmode="decimal" autocomplete="off" value={HOME_LOAN_DEFAULT_PROCESSING_FEE} />
            <p class="hint" data-i18n="home.fee-hint">Flat Rs 10,000 + FED is the well-evidenced figure (Meezan Easy Home Rs 10,000 + 16% FED; HBL Rs 10,000 second-hand). Valuation, legal opinion, stamp duty and transfer costs are extra, at actual.</p>
          </div>

          <div id="homeErrors" class="error-box" role="alert" hidden></div>

          <p class="u-actions">
            <button id="homeCalculate" class="btn-primary" type="submit" data-i18n="ui.calculate">Calculate</button>
            <button id="homeClear" class="btn-secondary" type="button" data-i18n="ui.clear">Clear</button>
          </p>
          <p id="homeFormStatus" role="status" class="u-muted-14"></p>
        </form>
      </div>

      <div class="result-card" id="homeResultCard" tabindex="-1">
        <div id="homeEmpty">
          <p class="u-fw-700" data-i18n="ui.empty-title">Your result will appear here.</p>
          <p data-i18n="ui.empty-sub">Enter your details to see your result.</p>
          <p class="u-muted-14" data-i18n="home.empty-note">
            You will see your monthly EMI — both phases in Apna Ghar mode — the financed amount, total interest, and the total cost.
          </p>
        </div>

        <div id="homeResult" data-result-text hidden>
          <p class="u-muted-14-bold" id="homeHeadlineLabel">Your monthly EMI</p>
          <div aria-live="polite" aria-atomic="true">
            <p class="result-value" id="homeHeadline"></p>
          </div>
          <div id="homePhase2Box" hidden>
            <p class="u-muted-14-bold" data-i18n="home.phase2-label">EMI from year 11 (phase 2)</p>
            <p class="result-value u-fs-28" id="homePhase2"></p>
          </div>
          <div class="stat-grid">
            <div>
              <p class="stat-label" data-i18n="home.stat1">Amount financed</p>
              <p class="stat-value" id="homeStat1"></p>
            </div>
            <div>
              <p class="stat-label" data-i18n="home.stat2">Total interest</p>
              <p class="stat-value" id="homeStat2"></p>
            </div>
            <div>
              <p class="stat-label" data-i18n="home.stat3">Equity / down payment</p>
              <p class="stat-value" id="homeStat3"></p>
            </div>
            <div>
              <p class="stat-label" data-i18n="home.stat4">Total cost</p>
              <p class="stat-value" id="homeStat4"></p>
            </div>
          </div>
          <div class="table-wrap">
          <table class="breakdown-table" id="homeBreakdown" aria-label="Home loan breakdown"></table>
          </div>
          <p id="homeCapWarning" class="notice-warning" hidden></p>
          <p id="homeEcho" class="u-muted-14"></p>
          <p id="homeFormula" class="u-fs-16"></p>
          <p class="u-muted-13">
            <span data-i18n="home.estimate">Estimate only — check important figures before acting.</span> <a href="#homeDisclaimer" data-i18n="ui.disclaimer-link">Read the full disclaimer.</a>
          </p>
        </div>

        <div class="actions-row no-print">
          <button type="button" class="btn-secondary" data-copy-result data-i18n="ui.copy" disabled>Copy result</button>
          <button type="button" class="btn-secondary" data-print-result data-i18n="ui.print" disabled>Print</button>
        </div>
        <p data-copy-status role="status" class="u-fs-14"></p>
      </div>
    </div>
  </div>

  <div class="container prose-narrow u-mt-40 pg-home-loan-calculator">
    <h2 data-i18n="home.how-h">How it works</h2>
    <ol>
      <li data-i18n="home.how1">Pick the loan type: commercial (one floating rate) or Apna Ghar (5% for 10 years, then KIBOR +3%). The equity, tenure and fee fields change to match the mode you pick.</li>
      <li data-i18n="home.how2">Enter the property price and your equity. The financed amount is the price minus the equity — 70–85% on a commercial loan, 90% under Apna Ghar.</li>
      <li data-i18n="home.how3">Enter the tenure in whole years (commercial: 3–25; Apna Ghar: 3–20) and the markup rate. In Apna Ghar mode also enter the post-subsidy rate for years 11 onwards — it is editable because KIBOR in year 11 is not known today.</li>
      <li data-i18n="home.how4">The EMI is worked out with the reducing-balance formula. In Apna Ghar mode the phase-1 EMI repays the loan over the full tenure at 5%; after 10 years the remaining balance is re-amortised at the post-subsidy rate, giving the phase-2 EMI.</li>
    </ol>

    <h2 data-i18n="home.formula-h">Formula</h2>
    <p data-i18n="home.f1">Financed amount = property price − equity</p>
    <p data-i18n="home.f2">EMI = P × R × (1+R)^N / ((1+R)^N − 1), where P is the financed amount, R is the monthly rate (annual markup ÷ 100 ÷ 12), and N is the number of months. If the rate is 0, EMI = P ÷ N.</p>
    <p data-i18n="home.f3">Apna Ghar: phase-1 EMI is the EMI over the full tenure at 5%; phase-2 EMI is the EMI on the balance still owed after 10 years, over the remaining months at the post-subsidy rate.</p>
    <p data-i18n="home.f4">Total cost = equity + total of all EMIs + processing fee</p>

    <h2 data-i18n="home.example-h">Worked examples</h2>
    <p><strong data-i18n="home.exa-label">Example A — Commercial:</strong> Rs 10,000,000<span data-i18n="home.exa-pre2"> property, </span>25%<span data-i18n="home.exa-pre3"> equity (</span>Rs 2,500,000<span data-i18n="home.exa-pre4">), so </span>Rs 7,500,000<span data-i18n="home.exa-pre5"> financed. At </span>16%<span data-i18n="home.exa-pre6"> per year for 20 years (240 months) the EMI is </span>Rs 104,344.20<span data-i18n="home.exa-pre7">, total interest is </span>Rs 17,542,600.13<span data-i18n="home.exa-pre8"> and the total paid on the loan is </span>Rs 25,042,600.13<span data-i18n="home.exa-pre9">. Add the equity and a </span>Rs 10,000<span data-i18n="home.exa-pre10"> processing fee and the total cost is </span>Rs 27,552,600.13<span data-i18n="home.exa-post">.</span></p>
    <p><strong data-i18n="home.exb-label">Example B — Apna Ghar:</strong><span data-i18n="home.exb-pre1"> the same </span>Rs 10,000,000<span data-i18n="home.exb-pre2"> property with </span>10%<span data-i18n="home.exb-pre3"> equity (</span>Rs 1,000,000<span data-i18n="home.exb-pre4">), so </span>Rs 9,000,000<span data-i18n="home.exb-pre5"> financed, over 20 years. Years 1–10 at </span>5%<span data-i18n="home.exb-pre6">: EMI </span>Rs 59,396.02<span data-i18n="home.exb-pre7">. After 10 years </span>Rs 5,599,936.10<span data-i18n="home.exb-pre8"> is still owed; years 11–20 at </span>16%<span data-i18n="home.exb-pre9">: EMI </span>Rs 93,806.28<span data-i18n="home.exb-pre10">. Total paid on the loan is </span>Rs 18,384,275.33<span data-i18n="home.exb-pre11"> and total interest is </span>Rs 9,384,275.33<span data-i18n="home.exb-pre12"> — with no processing fee. A single rate would be wrong: at </span>16%<span data-i18n="home.exb-pre13"> for the whole 20 years the total would be </span>Rs 30,051,135.38<span data-i18n="home.exb-pre14">, and at </span>5%<span data-i18n="home.exb-pre15"> for the whole 20 years it would be </span>Rs 14,255,043.39<span data-i18n="home.exb-post">. The two-phase total sits between them, which is exactly what the subsidy does.</span></p>
    <p class="u-muted-14" data-i18n="home.ex-verified">All examples use the figures verified 13 November 2026.</p>

    <h2 data-i18n="home.rates-h">Commercial markup by bank — November 2026</h2>
    <p data-i18n="home.rates-intro">All commercial rates are 1-year KIBOR (6-month KIBOR at MCB) plus the bank's spread, repriced yearly — so no single rate on this page is "the" home loan rate. The all-in commercial band in November 2026 was about 14.9–17.2% per year.</p>
    <div class="table-wrap">
    <table class="breakdown-table" aria-label="Home loan markup by bank">
      <thead>
        <tr><th scope="col" data-i18n="home.th-bank">Bank</th><th scope="col" data-i18n="home.th-spread">Markup / spread</th><th scope="col" data-i18n="home.th-note">Note</th></tr>
      </thead>
      <tbody>
        {HOME_LOAN_BANK_SPREADS.map((row) => (
          <tr>
            <td>{row.bank}</td>
            <td>{row.spread}</td>
            <td>{row.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
    <p class="u-muted-14" data-i18n="home.ceilings-note">SBP ceilings (August 2026, SH&amp;SFD Circular No. 04/2026): maximum tenure 30 years, maximum financing 90% of the property value, and total consumer instalments within 65% of net disposable income. These are ceilings, not bank terms — banks are stricter, which is why this calculator caps commercial tenure at 25 years. UBL Address tenure is not stated on its product page (its Ameen FAQ says 3–20 years). Commercial age limits could not be verified from any named bank page, so none are stated here.</p>

    <h2 data-i18n="home.apna-h">Apna Ghar scheme — the live subsidy</h2>
    <p data-i18n="home.apna-intro">The Wazir-e-Azam Apna Ghar Program – Ghar Ho Tu Apna is the live subsidised scheme (SBP SH&amp;SFD Circular No. 3/2025, 24 September 2025; renamed by the Ministry of Housing &amp; Works notification of 26 March 2026, SBP circular 1 April 2026; launched by the Prime Minister on 30 April 2026). Its terms:</p>
    <ul>
      <li><span data-i18n="home.apna1-pre">Financing up to Rs </span>{APNA_GHAR_MAX_FINANCING.toLocaleString('en-PK')}<span data-i18n="home.apna1-post"> — 90% of the property value, so 10% equity.</span></li>
      <li><span data-i18n="home.apna2-pre">Fixed </span>{APNA_GHAR_SUBSIDY_RATE_PCT}<span data-i18n="home.apna2-mid">% for the first </span>{APNA_GHAR_SUBSIDY_YEARS}<span data-i18n="home.apna2-post"> years, then 1-year KIBOR +3%.</span></li>
      <li data-i18n="home.apna3">Maximum tenure 20 years. No processing fee. No prepayment penalty.</li>
      <li data-i18n="home.apna4">First-time homeowners only — you must not already own a property. One subsidised loan per person, once only. Minimum age 25 for the primary applicant (MCB FAQ).</li>
      <li><span data-i18n="home.apna5-pre">House up to </span>{APNA_GHAR_MAX_HOUSE_MARLA}<span data-i18n="home.apna5-mid"> marla, or a flat up to </span>{APNA_GHAR_MAX_FLAT_SQFT.toLocaleString('en-PK')}<span data-i18n="home.apna5-post"> sq ft.</span></li>
      <li>{APNA_GHAR_HOMES_FY2025_26.toLocaleString('en-PK')}<span data-i18n="home.apna6-post"> homes in FY2025-26.</span></li>
    </ul>
    <p data-i18n="home.apna-tiers">The scheme was first launched as Mera Ghar Mera Ashiana with two tiers — 5% up to Rs 2m and 8% from Rs 2m to Rs 3.5m. Those tiers were replaced in March 2026 (ECC, February 2026) by a uniform 5% up to Rs 10m — pages still showing an 8% tier are out of date. The older Mera Pakistan Mera Ghar scheme (2020–2022, concluded) and its 2%/5%/7% tiers are obsolete and are not shown as live anywhere on this page.</p>
    <p class="u-muted-14" data-i18n="home.apna-punjab">Punjab's Apni Chhat Apna Ghar (interest-free, up to Rs 1.5m, 7 years) is mentioned here only as a weak, single-secondary-source, provincial-only note — it is not built into this calculator.</p>

    <h2 data-i18n="home.unsettled-h">What this page does not settle</h2>
    <p data-i18n="home.unsettled-intro">These points are stated plainly rather than filled in with a guess:</p>
    <ul>
      <li data-i18n="home.un1">Commercial home-loan age limits (minimum/maximum age) could not be verified from any named bank page — none are stated.</li>
      <li data-i18n="home.un2">"The property must be in the borrower's name" is not stated as a standalone rule — what the banks require is clear title, a valuation, a legal opinion, and a mortgage to the bank.</li>
      <li data-i18n="home.un3">Typical valuation and legal-opinion fee amounts are not published by any bank — they are extra, at actual, and are not in the EMI.</li>
      <li data-i18n="home.un4">Bank Alfalah, UBL and MCB commercial processing-fee amounts are not published; only the flat Rs 10,000 + FED figure (Meezan Schedule of Charges; HBL second-hand) is well evidenced.</li>
    </ul>

    <h2 data-i18n="home.faq-h">Frequently asked questions</h2>
    <div class="faq">
      {
        faqs.map((f, i) => (
          <details>
            <summary data-i18n={`home.faq${i + 1}q`}>{f.q}</summary>
            <p data-i18n={`home.faq${i + 1}a`}>{f.a}</p>
          </details>
        ))
      }
    </div>
    <p><span data-i18n="fr.contact-text">Still have a question?</span> <a href="/contact/" data-i18n="nav.contact">Contact us</a>.</p>

    <section id="homeDisclaimer" class="notice-info u-mt-32">
      <h2 class="u-fs-20" data-i18n="home.disc-h">Important — please read</h2>
      <p data-i18n="home.disc">
        Results are estimates for information only and are not financial advice.
        Home-loan rates are floating (KIBOR-linked) and change, and the
        post-subsidy rate in Apna Ghar mode is an assumption you enter — the
        rate in year 11 is not known today. The rate, fees and conditions on
        your bank's Key Fact Statement / offer letter govern, not this
        estimate. Confirm the terms with your bank before borrowing.
        Calculations run in your browser; nothing you enter is stored or sent
        to a server.
      </p>
      <p>Sources: {HOME_LOAN_SOURCE_CITATION}</p>
      <p><a href={HOME_LOAN_SOURCE_URL_SBP}>SBP SH&amp;SFD Circular No. 3/2025 (24 Sep 2025)</a>; <a href={HOME_LOAN_SOURCE_URL_MCB}>MCB Apna Ghar Program page</a>; <a href={HOME_LOAN_SOURCE_URL_MCB_FAQ}>MCB Apna Ghar FAQ (PDF, 8 April 2026)</a>. Checked 13 November 2026; next review 13 February 2027.</p>
      <p><a href="/terms/" data-i18n="ui.terms-link">Read the full Terms &amp; Disclaimer</a>.</p>
    </section>

    <h2 class="u-mt-32" data-i18n="home.related-h">Related tools</h2>
    <div class="related-grid">
      {
        related.map((tool, i) => (
          <article class="card">
            <h3 class="u-fs-18">
              <a href={tool.href} data-i18n={`home.rel${i + 1}`}>{tool.name}</a>
            </h3>
            <p class="u-txt-muted" data-i18n={`home.rel${i + 1}-desc`}>{tool.desc}</p>
            <p>
              <a href={tool.href} data-i18n="home.use-calculator">Use the calculator →</a>
            </p>
          </article>
        ))
      }
    </div>
  </div>

  <script>
    import { calcHomeLoan, parseDecimal, formatPKR, formatNumber } from '../lib/calc.ts';
    import { APNA_GHAR_MIN_EQUITY_PCT, APNA_GHAR_SUBSIDY_RATE_PCT, APNA_GHAR_SUBSIDY_YEARS, HOME_LOAN_EQUITY_PCT_MIN_COMMERCIAL, HOME_LOAN_EQUITY_PCT_MAX_COMMERCIAL, HOME_LOAN_TENURE_MAX_YEARS_COMMERCIAL, APNA_GHAR_MAX_TENURE_YEARS, HOME_LOAN_TENURE_MIN_YEARS } from '../config/home-loan.ts';

    const form = document.getElementById('homeForm');
    const errorsBox = document.getElementById('homeErrors');
    const emptyBox = document.getElementById('homeEmpty');
    const resultBox = document.getElementById('homeResult');
    const resultCard = document.getElementById('homeResultCard');
    const headlineLabel = document.getElementById('homeHeadlineLabel');
    const headline = document.getElementById('homeHeadline');
    const phase2Box = document.getElementById('homePhase2Box');
    const phase2El = document.getElementById('homePhase2');
    const stat1 = document.getElementById('homeStat1');
    const stat2 = document.getElementById('homeStat2');
    const stat3 = document.getElementById('homeStat3');
    const stat4 = document.getElementById('homeStat4');
    const breakdownEl = document.getElementById('homeBreakdown');
    const capWarningEl = document.getElementById('homeCapWarning');
    const echoEl = document.getElementById('homeEcho');
    const formulaEl = document.getElementById('homeFormula');
    const copyBtn = document.querySelector('[data-copy-result]');
    const printBtn = document.querySelector('[data-print-result]');
    const formStatus = document.getElementById('homeFormStatus');
    const modeSelect = document.getElementById('homeMode');
    const modeHint = document.getElementById('homeModeHint');
    const equityInput = document.getElementById('homeEquity');
    const equityHint = document.getElementById('homeEquityHint');
    const tenureInput = document.getElementById('homeTenure');
    const tenureHint = document.getElementById('homeTenureHint');
    const rateLabel = document.getElementById('homeRateLabel');
    const rateHint = document.getElementById('homeRateHint');
    const postRateField = document.getElementById('homePostRateField');
    const feeField = document.getElementById('homeFeeField');

    function isApna() {
      return modeSelect.value === 'apna-ghar';
    }
    function updateModeTexts() {
      // The mode-dependent hints and the rate label are rewritten by this
      // script whenever the mode changes, so they are translated here (not
      // via data-i18n) and refreshed by the __pfcAfterLang hook when the
      // language toggles. The text-setting is kept separate from the value
      // clamps in updateModeUI, so a language toggle never changes an
      // entered equity or tenure.
      const urdu = document.documentElement.lang === 'ur';
      if (isApna()) {
        modeHint.textContent = urdu
          ? 'اپنا گھر: پہلے 10 سال کے لیے 5% مقررہ، پھر 1 سالہ KIBOR +3%۔ صرف پہلی بار گھر خریدنے والوں کے لیے، Rs 10m تک فنانس شدہ، زیادہ سے زیادہ 20 سال، کوئی پروسیسنگ فیس نہیں۔'
          : 'Apna Ghar: 5% fixed for the first 10 years, then 1-year KIBOR +3%. First-time homeowners only, up to Rs 10m financed, maximum 20 years, no processing fee.';
        equityHint.textContent = urdu
          ? 'اپنا گھر: 10–30% ایکویٹی (اسکیم 90% فنانس کرتی ہے، اس لیے 10% کم از کم ہے)۔'
          : 'Apna Ghar: 10–30% equity (the scheme finances 90%, so 10% is the minimum).';
        tenureHint.textContent = urdu
          ? `پورے سال، ${HOME_LOAN_TENURE_MIN_YEARS}–${APNA_GHAR_MAX_TENURE_YEARS} (اپنا گھر کی حد 20 سال ہے)۔`
          : `Whole years, ${HOME_LOAN_TENURE_MIN_YEARS}–${APNA_GHAR_MAX_TENURE_YEARS} (Apna Ghar caps at 20 years).`;
        rateLabel.innerHTML = urdu
          ? 'مارک اپ شرح (% سالانہ) <span aria-hidden="true">*</span>'
          : 'Markup rate (% per year) <span aria-hidden="true">*</span>';
        rateHint.textContent = urdu
          ? 'اپنا گھر موڈ میں یہ شرح پہلے 10 سال کے لیے استعمال نہیں ہوتی (وہ 5% پر مقررہ ہیں) — یہ سبسڈی کے بعد کی شرح کے طور پر رکھی گئی ہے۔ سبسڈی کے بعد کی شرح نیچے درج کریں۔'
          : 'In Apna Ghar mode this rate is not used for the first 10 years (those are fixed at 5%) — it is kept as the fallback post-subsidy rate. Enter the post-subsidy rate below.';
      } else {
        modeHint.textContent = urdu
          ? 'کمرشل: پوری مدت کے لیے ایک تیرتی شرح۔ اپنا گھر: پہلی بار گھر خریدنے والوں کے لیے حکومت کی سبسڈی والی اسکیم، Rs 10m تک، زیادہ سے زیادہ 20 سال۔'
          : 'Commercial: one floating rate for the whole tenure. Apna Ghar: the government-subsidised scheme for first-time homeowners, up to Rs 10m, maximum 20 years.';
        equityHint.textContent = urdu
          ? `کمرشل: ${HOME_LOAN_EQUITY_PCT_MIN_COMMERCIAL}–${HOME_LOAN_EQUITY_PCT_MAX_COMMERCIAL}% (بینک 70–85% فنانس کرتے ہیں)۔ SBP 90% تک فنانسنگ کی حد دیتا ہے، لیکن بینک سخت ہیں۔`
          : `Commercial: ${HOME_LOAN_EQUITY_PCT_MIN_COMMERCIAL}–${HOME_LOAN_EQUITY_PCT_MAX_COMMERCIAL}% (banks finance 70–85%). SBP allows up to 90% financing as a ceiling, but banks are stricter.`;
        tenureHint.textContent = urdu
          ? `پورے سال، ${HOME_LOAN_TENURE_MIN_YEARS}–${HOME_LOAN_TENURE_MAX_YEARS_COMMERCIAL} کمرشل قرض کے لیے (بینکوں کی حد 25؛ SBP 30 دیتا ہے)۔ اپنا گھر کی حد 20 سال ہے۔`
          : `Whole years, ${HOME_LOAN_TENURE_MIN_YEARS}–${HOME_LOAN_TENURE_MAX_YEARS_COMMERCIAL} for a commercial loan (banks cap at 25; SBP allows 30). Apna Ghar caps at 20 years.`;
        rateLabel.innerHTML = urdu
          ? 'مارک اپ شرح (% سالانہ) <span aria-hidden="true">*</span>'
          : 'Markup rate (% per year) <span aria-hidden="true">*</span>';
        rateHint.textContent = urdu
          ? 'پہلے سے طے شدہ 16% — نومبر 2026 کے کمرشل بینڈ تقریباً 14.9–17.2% کے اندر (KIBOR + تقریباً 3%)۔ وہ شرح درج کریں جو آپ کا بینک بتاتا ہے۔'
          : 'Default 16% — inside the November 2026 commercial band of about 14.9–17.2% (KIBOR + about 3%). Enter the rate your bank quotes you.';
      }
    }
    function updateModeUI() {
      updateModeTexts();
      if (isApna()) {
        postRateField.hidden = false;
        feeField.hidden = true;
        if (parseDecimal(equityInput.value) === 25) equityInput.value = '10';
        const t = parseDecimal(tenureInput.value);
        if (t !== null && t > APNA_GHAR_MAX_TENURE_YEARS) tenureInput.value = String(APNA_GHAR_MAX_TENURE_YEARS);
      } else {
        postRateField.hidden = true;
        feeField.hidden = false;
        if (parseDecimal(equityInput.value) === 10) equityInput.value = '25';
      }
    }
    modeSelect.addEventListener('change', updateModeUI);
    updateModeUI();

    function showEmpty() {
      resultBox.hidden = true;
      emptyBox.hidden = false;
      copyBtn.disabled = true;
      printBtn.disabled = true;
    }
    function showResult() {
      emptyBox.hidden = true;
      resultBox.hidden = false;
      copyBtn.disabled = false;
      printBtn.disabled = false;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      try {
        const price = parseDecimal(document.getElementById('homePrice').value);
        if (price === null) throw new Error('Enter the property price in rupees, using digits and one decimal point only.');
        const equityPct = parseDecimal(equityInput.value);
        if (equityPct === null) throw new Error('Enter the equity as a percentage, using digits and one decimal point only.');
        const tenureYears = parseDecimal(tenureInput.value);
        if (tenureYears === null) throw new Error('Enter the tenure in whole years, using digits only.');
        const rate = parseDecimal(document.getElementById('homeRate').value);
        if (rate === null) throw new Error('Enter the markup rate as a percentage, using digits and one decimal point only.');
        const postRate = parseDecimal(document.getElementById('homePostRate').value);
        if (isApna() && postRate === null) throw new Error('Enter the post-subsidy rate as a percentage, using digits and one decimal point only.');
        const fee = parseDecimal(document.getElementById('homeFee').value);
        if (!isApna() && fee === null) throw new Error('Enter the processing fee in rupees, using digits and one decimal point only.');
        const r = calcHomeLoan({
          mode: modeSelect.value,
          price,
          equityPct,
          tenureYears,
          ratePct: rate,
          postSubsidyRatePct: isApna() ? postRate : undefined,
          processingFee: isApna() ? 0 : fee,
        });

        errorsBox.textContent = '';
        errorsBox.hidden = true;
        // The headline label is rewritten on every calculation, so it is
        // translated here (not via data-i18n) and refreshed by the
        // __pfcAfterLang hook in i18n.js when the language toggles.
        const urdu = document.documentElement.lang === 'ur';
        if (r.mode === 'apna-ghar') {
          headlineLabel.textContent = r.phase2Emi === null
            ? (urdu ? 'آپ کی ماہانہ EMI (5% سبسڈی، پوری مدت)' : 'Your monthly EMI (5% subsidy, whole tenure)')
            : (urdu ? 'آپ کی ماہانہ EMI — سال 1–10 (مرحلہ 1، 5%)' : 'Your monthly EMI — years 1–10 (phase 1, 5%)');
          headline.textContent = formatPKR(r.emi, 2);
          if (r.phase2Emi !== null) {
            phase2El.textContent = formatPKR(r.phase2Emi, 2);
            phase2Box.hidden = false;
          } else {
            phase2Box.hidden = true;
          }
        } else {
          headlineLabel.textContent = urdu ? 'آپ کی ماہانہ EMI' : 'Your monthly EMI';
          headline.textContent = formatPKR(r.emi, 2);
          phase2Box.hidden = true;
        }
        stat1.textContent = formatPKR(r.financed, 0);
        stat2.textContent = formatPKR(r.totalInterest, 0);
        stat3.textContent = formatPKR(r.downPayment, 0);
        stat4.textContent = formatPKR(r.totalCost, 0);

        let rows = '';
        rows += '<tr><td>Property price</td><td>' + formatPKR(r.price, 0) + '</td></tr>';
        rows += '<tr><td>Equity / down payment (' + formatNumber(equityPct, 2) + '%)</td><td>' + formatPKR(r.downPayment, 0) + '</td></tr>';
        rows += '<tr><td>Amount financed</td><td>' + formatPKR(r.financed, 0) + '</td></tr>';
        if (r.mode === 'apna-ghar') {
          rows += '<tr><td>EMI, years 1–10 (' + APNA_GHAR_SUBSIDY_RATE_PCT + '% fixed)</td><td>' + formatPKR(r.phase1Emi, 2) + ' / month</td></tr>';
          if (r.phase2Emi !== null) {
            rows += '<tr><td>EMI, year 11 onwards (' + formatNumber(postRate, 2) + '%)</td><td>' + formatPKR(r.phase2Emi, 2) + ' / month</td></tr>';
            rows += '<tr><td>Balance still owed after 10 years</td><td>' + formatPKR(r.balanceAfterPhase1, 0) + '</td></tr>';
          }
          rows += '<tr><td>Processing fee</td><td>Rs 0 (none under Apna Ghar)</td></tr>';
        } else {
          rows += '<tr><td>Monthly EMI (' + r.tenureMonths + ' months at ' + formatNumber(rate, 2) + '%)</td><td>' + formatPKR(r.emi, 2) + '</td></tr>';
          rows += '<tr><td>Processing fee (flat)</td><td>' + formatPKR(r.processingFee, 0) + '</td></tr>';
        }
        rows += '<tr><td>Total interest</td><td>' + formatPKR(r.totalInterest, 0) + '</td></tr>';
        rows += '<tr class="total-row"><td>Total cost</td><td>' + formatPKR(r.totalCost, 0) + '</td></tr>';
        breakdownEl.innerHTML = '<tbody>' + rows + '</tbody>';

        if (r.apnaCapExceeded) {
          capWarningEl.textContent = 'Over the scheme cap: the financed amount ' + formatPKR(r.financed, 0) + ' is above the Apna Ghar limit of Rs 10,000,000. Raise the equity so the financed amount is Rs 10,000,000 or less, or use a commercial loan for the rest.';
          capWarningEl.hidden = false;
        } else {
          capWarningEl.textContent = '';
          capWarningEl.hidden = true;
        }

        if (r.mode === 'apna-ghar') {
          echoEl.textContent = 'Based on: Apna Ghar, property price ' + formatPKR(price, 0) + ', equity ' + formatNumber(equityPct, 2) + '% (' + formatPKR(r.downPayment, 0) + '), tenure ' + tenureYears + ' years, 5% fixed for the first ' + APNA_GHAR_SUBSIDY_YEARS + ' years' + (r.phase2Emi !== null ? ', then ' + formatNumber(postRate, 2) + '% per year' : '') + ' (reducing balance).';
          formulaEl.textContent = 'Phase-1 EMI = ' + formatPKR(r.phase1Emi, 2) + ' per month at 5% over ' + r.tenureMonths + ' months' + (r.phase2Emi !== null ? '; phase-2 EMI = ' + formatPKR(r.phase2Emi, 2) + ' per month on the balance of ' + formatPKR(r.balanceAfterPhase1, 0) + ' at ' + formatNumber(postRate, 2) + '% over ' + r.phase2Months + ' months.' : '.');
        } else {
          echoEl.textContent = 'Based on: commercial loan, property price ' + formatPKR(price, 0) + ', equity ' + formatNumber(equityPct, 2) + '% (' + formatPKR(r.downPayment, 0) + '), tenure ' + tenureYears + ' years, markup ' + formatNumber(rate, 2) + '% per year (reducing balance).';
          formulaEl.textContent = 'EMI = P x R x (1+R)^N / ((1+R)^N - 1) = ' + formatPKR(r.financed, 0) + ' at ' + formatNumber(rate, 2) + '% per year over ' + r.tenureMonths + ' months = ' + formatPKR(r.emi, 2) + ' per month.';
        }
        showResult();
        if (window.matchMedia('(max-width: 899px)').matches) resultCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (err) {
        errorsBox.textContent = err.message;
        errorsBox.hidden = false;
        showEmpty();
      }
    });

    document.getElementById('homeClear').addEventListener('click', () => {
      form.reset();
      errorsBox.textContent = '';
      errorsBox.hidden = true;
      formStatus.textContent = 'Form cleared.';
      updateModeUI();
      showEmpty();
    });
    // Refresh script-managed labels when the language toggles (i18n.js
    // calls this after swapping every [data-i18n] element).
    window.__pfcAfterLang = function (lang) {
      updateModeTexts();
      if (!resultBox.hidden) {
        const urdu = lang === 'ur';
        if (isApna()) {
          headlineLabel.textContent = urdu
            ? (phase2Box.hidden ? 'آپ کی ماہانہ EMI (5% سبسڈی، پوری مدت)' : 'آپ کی ماہانہ EMI — سال 1–10 (مرحلہ 1، 5%)')
            : (phase2Box.hidden ? 'Your monthly EMI (5% subsidy, whole tenure)' : 'Your monthly EMI — years 1–10 (phase 1, 5%)');
        } else {
          headlineLabel.textContent = urdu ? 'آپ کی ماہانہ EMI' : 'Your monthly EMI';
        }
      }
    };
    showEmpty();
  </script>
</Layout>
