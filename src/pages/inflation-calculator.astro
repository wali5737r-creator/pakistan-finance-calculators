---
import Layout from '../components/Layout.astro';
import '../styles/pages/inflation-calculator.css';

const title = "Inflation Calculator | Future Cost & Buying Power | Pakistan Finance Calculators";
const description = "See what today's money will buy in the future: the future cost of an amount and its purchasing power, at the inflation rate and years you assume.";
const slug = "/inflation-calculator/";

const faqs = [
  {
    q: "What does the future cost figure mean?",
    a: "It is what the same thing would cost after the years you entered, if prices rose at the inflation rate you assumed every year. For example, Rs 100,000 today at 8% for 10 years becomes Rs 215,892.50.",
  },
  {
    q: "What does purchasing power mean?",
    a: "It is what today's amount would be worth in the future, measured in today's prices. Rs 100,000 held for 10 years at 8% inflation would buy what Rs 46,319.35 buys today.",
  },
  {
    q: "Is the inflation rate I enter a forecast?",
    a: "No. It is an assumption you choose, to see the effect of a steady rate. Real inflation changes every year, so try a lower and a higher rate to see the range of outcomes.",
  },
  {
    q: "Does the calculator use Pakistan's actual inflation rate?",
    a: "No. No official or live inflation figure is used. You enter the rate, and the result is labelled as your assumption throughout.",
  },
  {
    q: "Why does the increase look so large over many years?",
    a: "Because inflation compounds, like interest: each year's rise applies to the already-risen price. That is why the effect grows faster the longer the period.",
  },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://pakistan-finance-calculators.pages.dev/inflation-calculator/#webapp',
      name: "Inflation Calculator",
      url: 'https://pakistan-finance-calculators.pages.dev/inflation-calculator/',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      description,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pakistan-finance-calculators.pages.dev/' },
        {
          '@type': 'ListItem',
          position: 2,
          name: "Inflation Calculator",
          item: 'https://pakistan-finance-calculators.pages.dev/inflation-calculator/',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});

const related = [
  {
    href: "/compound-interest-calculator/",
    name: "Compound Interest Calculator",
    desc: "How savings grow with compound interest, with a year-by-year table, from the figures you enter.",
  },
  {
    href: "/fixed-deposit-calculator/",
    name: "Fixed Deposit Calculator",
    desc: "Maturity amount and profit on a fixed deposit, with the profit rate and tax you enter.",
  },
];
---
<Layout title={title} description={description} slug={slug} schema={schema}>
  <div class="container u-pt-32 pg-inflation-calculator">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <p class="u-muted-14"><a href="/" data-i18n="nav.home">Home</a> / <span data-i18n="infl.crumb">Inflation Calculator</span></p>
    </nav>
    <p class="badge badge-info u-mt-8" data-i18n="infl.badge">Money Over Time</p>
    <h1 class="u-hero-title" data-i18n="infl.h1">Inflation Calculator</h1>
    <p class="prose-narrow u-lede" data-i18n="infl.intro">
      Prices rise, so the same amount of money buys less over time. Enter an amount, the yearly inflation rate you assume, and how many years ahead to look, and see what that amount will cost in the future — and what today's money will be worth then, in today's terms.
    </p>
    <p class="notice-info prose-narrow u-mt-16">
      <strong data-i18n="infl.notice-label">No live data.</strong> <span data-i18n="infl.notice-text">Every rate, price, and percentage on this page is entered by
      you. Nothing is fetched from a bank, a market, or a government source, and no figure here
      is presented as a live or official rate.</span>
    </p>
  </div>

  <div class="container u-mt-20 pg-inflation-calculator">
    <div class="tool-grid">
      <div class="card">
        <form id="inflForm" novalidate>
          <div class="field">
            <label for="inflAmount"><span data-i18n="infl.amount-label">Amount today (Rs)</span> <span aria-hidden="true">*</span></label>
            <input id="inflAmount" type="text" inputmode="decimal" autocomplete="off" aria-required="true" />
            <p class="hint" data-i18n="infl.amount-hint">The cost of something today, or an amount of money you hold today.</p>
          </div>

          <div class="field">
            <label for="inflRate"><span data-i18n="infl.rate-label">Annual inflation rate (%)</span> <span aria-hidden="true">*</span></label>
            <input id="inflRate" type="text" inputmode="decimal" autocomplete="off" aria-required="true" />
            <p class="hint" data-i18n="infl.rate-hint">The yearly inflation rate you assume. This is your assumption, not a forecast and not an official figure.</p>
          </div>

          <div class="field">
            <label for="inflYears"><span data-i18n="infl.years-label">Years</span> <span aria-hidden="true">*</span></label>
            <input id="inflYears" type="text" inputmode="decimal" autocomplete="off" aria-required="true" />
            <p class="hint" data-i18n="infl.years-hint">How many years ahead to look, from 0 to 100. Whole or part years are allowed.</p>
          </div>

          <div id="inflErrors" class="error-box" role="alert" hidden></div>

          <p class="u-actions">
            <button id="inflCalculate" class="btn-primary" type="submit" data-i18n="ui.calculate">Calculate</button>
            <button id="inflClear" class="btn-secondary" type="button" data-i18n="ui.clear">Clear</button>
          </p>
          <p id="inflFormStatus" role="status" class="u-muted-14"></p>
        </form>
      </div>

      <div class="result-card" id="inflResultCard" tabindex="-1">
        <div id="inflEmpty">
          <p class="u-fw-700" data-i18n="ui.empty-title">Your result will appear here.</p>
          <p data-i18n="ui.empty-sub">Enter your details to see your result.</p>
          <p class="u-muted-14" data-i18n="ui.empty-note">
            You will see your answer with the figures shown, so you can check it.
          </p>
        </div>

        <div id="inflResult" data-result-text hidden>
          <p class="u-muted-14-bold" data-i18n="infl.result-label">Result</p>
          <div aria-live="polite" aria-atomic="true">
            <p class="result-value" id="inflHeadline"></p>
          </div>
          <div class="stat-grid">
            <div>
              <p class="stat-label" data-i18n="infl.stat1">Purchasing power in today's terms</p>
              <p class="stat-value" id="inflStat1"></p>
            </div>
            <div>
              <p class="stat-label" data-i18n="infl.stat2">Increase in cost</p>
              <p class="stat-value" id="inflStat2"></p>
            </div>
          </div>
          <p id="inflEcho" class="u-muted-14"></p>
          <p id="inflFormula" class="u-fs-16"></p>
          <p class="u-muted-13">
            <span data-i18n="infl.estimate">Estimate only — check important figures before acting.</span> <a href="#inflDisclaimer" data-i18n="ui.disclaimer-link">Read the full disclaimer.</a>
          </p>
        </div>

        <div class="actions-row no-print">
          <button type="button" class="btn-secondary" data-copy-result data-i18n="ui.copy" disabled>Copy result</button>
          <button type="button" class="btn-secondary" data-print-result data-i18n="ui.print" disabled>Print</button>
        </div>
        <p data-copy-status role="status" class="u-fs-14"></p>
      </div>
    </div>
  </div>

  <div class="container prose-narrow u-mt-40 pg-inflation-calculator">
    <h2 data-i18n="infl.how-h">How it works</h2>
    <ol>
      <li data-i18n="infl.how1">Enter an amount — the price of something today, or an amount of money you hold.</li>
      <li data-i18n="infl.how2">Enter the annual inflation rate you assume, and the number of years. The rate is your assumption: inflation is never steady in real life.</li>
      <li data-i18n="infl.how3">You see the future cost of the same thing, and the purchasing power of today's amount after that many years — what it would be worth, measured in today's prices.</li>
    </ol>
    <p data-i18n="infl.how-note">The two figures are two sides of the same calculation. If something costing Rs 100,000 today will cost Rs 215,892.50 in 10 years at 8% inflation, then Rs 100,000 held for 10 years will only buy what Rs 46,319.35 buys today.</p>

    <h2 data-i18n="infl.formula-h">Formula</h2>
    <p><span data-i18n="infl.f1">Future cost = Amount × (1 + inflation rate)</span><sup>years</sup></p>
    <p><span data-i18n="infl.f2">Purchasing power = Amount ÷ (1 + inflation rate)</span><sup>years</sup></p>
    <p><span data-i18n="infl.formula-note-pre">The same assumed rate is used for every year. Real inflation varies year to year, so the result is an illustration, not a prediction. To see savings growing against rising prices, try the </span><a href="/compound-interest-calculator/" data-i18n="card.compound.name">Compound Interest Calculator</a>.</p>

    <h2 data-i18n="infl.example-h">Worked example</h2>
    <p><strong data-i18n="infl.ex-label">Example:</strong><span data-i18n="infl.ex-rest-pre"> Rs 100,000 today, at 8% inflation a year for 10 years, would cost Rs 215,892.50 in the future (100,000 × 1.08</span><sup>10</sup><span data-i18n="infl.ex-rest-mid">). The same Rs 100,000 kept for 10 years would have the purchasing power of Rs 46,319.35 in today's terms (100,000 ÷ 1.08</span><sup>10</sup>).</p>

    <h2 data-i18n="infl.faq-h">Frequently asked questions</h2>
    <div class="faq">
      {
        faqs.map((f, i) => (
          <details>
            <summary data-i18n={`infl.faq${i + 1}q`}>{f.q}</summary>
            <p data-i18n={`infl.faq${i + 1}a`}>{f.a}</p>
          </details>
        ))
      }
    </div>
    <p><span data-i18n="fr.contact-text">Still have a question?</span> <a href="/contact/" data-i18n="nav.contact">Contact us</a>.</p>

    <section id="inflDisclaimer" class="notice-info u-mt-32">
      <h2 class="u-fs-20" data-i18n="infl.disc-h">Important — please read</h2>
      <p data-i18n="infl.disc">
        Results are illustrations based on the inflation rate you assume. The rate is your assumption, not a forecast, not an official statistic, and not a promise about future prices. Real inflation varies every year and differs between goods and services. This is not financial advice.
      </p>
      <p><a href="/terms/" data-i18n="ui.terms-link">Read the full Terms &amp; Disclaimer</a>.</p>
    </section>

    <h2 class="u-mt-32" data-i18n="infl.related-h">Related tools</h2>
    <div class="related-grid">
      {
        related.map((tool, i) => (
          <article class="card">
            <h3 class="u-fs-18">
              <a href={tool.href} data-i18n={`infl.rel${i + 1}`}>{tool.name}</a>
            </h3>
            <p class="u-txt-muted" data-i18n={`infl.rel${i + 1}-desc`}>{tool.desc}</p>
            <p>
              <a href={tool.href} data-i18n="home.use-calculator">Use the calculator →</a>
            </p>
          </article>
        ))
      }
    </div>
  </div>

  <script>
    import { calcInflation, parseDecimal, formatPKR, formatNumber } from '../lib/calc.ts';

    const form = document.getElementById('inflForm');
    const errorsBox = document.getElementById('inflErrors');
    const emptyBox = document.getElementById('inflEmpty');
    const resultBox = document.getElementById('inflResult');
    const resultCard = document.getElementById('inflResultCard');
    const headline = document.getElementById('inflHeadline');
    const stat1 = document.getElementById('inflStat1');
    const stat2 = document.getElementById('inflStat2');
    const echoEl = document.getElementById('inflEcho');
    const formulaEl = document.getElementById('inflFormula');
    const copyBtn = document.querySelector('[data-copy-result]');
    const printBtn = document.querySelector('[data-print-result]');
    const formStatus = document.getElementById('inflFormStatus');

    function readNumber(id, label) {
      const raw = document.getElementById(id).value;
      if (raw.trim() === '') throw new Error(label + ' is required.');
      const value = parseDecimal(raw);
      if (value === null) throw new Error(label + ' must be a number using digits and one decimal point only.');
      return value;
    }
    function showEmpty() {
      resultBox.hidden = true;
      emptyBox.hidden = false;
      copyBtn.disabled = true;
      printBtn.disabled = true;
    }
    function showResult() {
      emptyBox.hidden = true;
      resultBox.hidden = false;
      copyBtn.disabled = false;
      printBtn.disabled = false;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      try {
        const amount = readNumber('inflAmount', 'Amount');
        const rate = readNumber('inflRate', 'Inflation rate');
        const years = readNumber('inflYears', 'Years');
        const r = calcInflation(amount, rate, years);
        errorsBox.textContent = '';
        errorsBox.hidden = true;
        headline.textContent = formatPKR(r.futureCost, 2);
        stat1.textContent = formatPKR(r.purchasingPower, 2);
        stat2.textContent = formatPKR(r.futureCost - amount, 2);
        echoEl.textContent = 'Based on: ' + formatPKR(amount, 2) + ' today, inflation ' + formatNumber(rate, 2) + '% per year, for ' + formatNumber(years, 2) + ' years.';
        formulaEl.textContent = 'Future cost = ' + formatPKR(amount, 2) + ' x (1 + ' + formatNumber(rate, 2) + '%)^' + formatNumber(years, 2) + ' = ' + formatPKR(r.futureCost, 2) + '. Purchasing power = ' + formatPKR(amount, 2) + ' / (1 + ' + formatNumber(rate, 2) + '%)^' + formatNumber(years, 2) + ' = ' + formatPKR(r.purchasingPower, 2) + '.';
        showResult();
        if (window.matchMedia('(max-width: 899px)').matches) resultCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (err) {
        errorsBox.textContent = err.message;
        errorsBox.hidden = false;
        showEmpty();
      }
    });

    document.getElementById('inflClear').addEventListener('click', () => {
      form.reset();
      errorsBox.textContent = '';
      errorsBox.hidden = true;
      formStatus.textContent = document.documentElement.lang === 'ur' ? 'فارم صاف کر دیا گیا۔' : 'Form cleared.';
      showEmpty();
    });
    // Refresh the script-managed "Form cleared." status when the language toggles.
    window.__pfcAfterLang = function (lang) {
      if (formStatus.textContent === 'Form cleared.' || formStatus.textContent === 'فارم صاف کر دیا گیا۔') {
        formStatus.textContent = lang === 'ur' ? 'فارم صاف کر دیا گیا۔' : 'Form cleared.';
      }
    };
    showEmpty();

  </script>
</Layout>
