---
import Layout from '../components/Layout.astro';
import {
  AREA_UNITS,
  DEFAULT_MARLA_STANDARD_ID,
  MARLA_STANDARDS,
  UNIT_REGION,
  UNIT_SOURCE_CITATION,
  UNIT_SOURCE_STATUS,
  areaUnitsForStandard,
  marlaStandardById,
} from '../config/units.ts';
import { convertArea, formatNumber } from '../lib/calc.ts';

const title = 'Marla to Square Feet Converter | Kanal, Acre & Sq Yd | Pakistan Finance Calculators';
const description =
  'Convert marla, kanal, acre, square feet, square yards, square metres and hectares. Punjab definition shown with its source — free, instant and accurate.';

const unitById = (id: string) => AREA_UNITS.find((unit) => unit.id === id)!;
const marlaUnit = unitById('marla');
const kanalUnit = unitById('kanal');
const acreUnit = unitById('acre');
const sqftUnit = unitById('sqft');
const sqydUnit = unitById('sqyd');

const canonicalLine =
  `1 ${marlaUnit.label} = ${formatNumber(marlaUnit.sqft, 2)} ${sqftUnit.label} · ` +
  `1 ${kanalUnit.label} = ${formatNumber(kanalUnit.sqft, 0)} ${sqftUnit.label} ` +
  `(20 ${marlaUnit.label}) · ` +
  `1 ${acreUnit.label} = ${formatNumber(acreUnit.sqft, 0)} ${sqftUnit.label}`;

const exampleSqFt = formatNumber(convertArea(10, 'marla', 'sqft'), 2);
const exampleSqYd = formatNumber(convertArea(10, 'marla', 'sqyd'), 2);
const exampleKanal = formatNumber(convertArea(10, 'marla', 'kanal'), 2);

const sourceNote = UNIT_SOURCE_CITATION
  ? `Source: ${UNIT_SOURCE_CITATION}.`
  : 'No source has been cited yet.';

const faqs = [
  {
    question: 'How many square feet are in 1 marla?',
    answer:
      `1 ${marlaUnit.label} = ${formatNumber(marlaUnit.sqft, 2)} ${sqftUnit.label}, ` +
      `using the ${UNIT_REGION} definition (${UNIT_SOURCE_STATUS}).`,
  },
  {
    question: 'How many marla are in 1 kanal?',
    answer:
      `1 ${kanalUnit.label} = ${formatNumber(kanalUnit.sqft / marlaUnit.sqft, 0)} ${marlaUnit.label}, ` +
      `using the ${UNIT_REGION} definition (${UNIT_SOURCE_STATUS}).`,
  },
  {
    question: 'Is a marla the same size in every province or housing society?',
    answer:
      `No. Use the standard selector above the calculator: the ${UNIT_REGION} revenue ` +
      `standard is 1 marla = 272.25 sq ft (1 kanal = 5,445 sq ft), while DHA, Bahria Town ` +
      `and LDA schemes use 1 marla = 225 sq ft (1 kanal = 4,500 sq ft). A 250 sq ft municipal ` +
      `variant is also reported in some Islamabad/CDA areas and is not offered here. ` +
      'For important measurements, check the dimensions on your registry or the ' +
      "society's approved layout plan — the plot dimensions matter more than the unit name.",
  },
  {
    question: 'Which definition does this converter use?',
    answer:
      `This converter uses the ${UNIT_REGION} definition of marla and kanal. ${UNIT_SOURCE_STATUS}. ${sourceNote}`,
  },
  {
    question: 'What units can I convert between?',
    answer: `You can convert between ${AREA_UNITS.map((unit) => unit.label).join(', ')}.`,
  },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://pakistan-finance-calculators.pages.dev/unit-marla-converter/#webapp',
      name: 'Unit / Marla Converter',
      url: 'https://pakistan-finance-calculators.pages.dev/unit-marla-converter/',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      description,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pakistan-finance-calculators.pages.dev/' },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Unit / Marla Converter',
          item: 'https://pakistan-finance-calculators.pages.dev/unit-marla-converter/',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://pakistan-finance-calculators.pages.dev/unit-marla-converter/#faq',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
});
---

<Layout title={title} description={description} slug="/unit-marla-converter/" schema={schema}>
  <div class="container" style="padding-top: 32px;">
    <nav class="breadcrumb" aria-label="Breadcrumb" style="font-size: 14px; margin-bottom: 12px;">
      <a href="/" data-i18n="nav.home">Home</a> / <span data-i18n="marla.crumb">Unit / Marla Converter</span>
    </nav>
    <h1 data-i18n="marla.h1">Unit / Marla Converter</h1>
    <p class="prose-narrow" style="font-size: 1.0625rem; margin-top: 12px;" data-i18n="marla.intro">
      Convert land area between marla, kanal, acre, square feet, square yards,
      square metres and hectares. Choose the marla standard that matches your
      land — Punjab revenue (272.25 sq ft per marla, default) or housing-society
      (225 sq ft per marla, DHA / Bahria / LDA). Free, instant and private — nothing you enter is stored.
    </p>
    <p id="lang-note" class="lang-note" data-i18n="tax.others-note" hidden>The other calculators on this site are still in English in this phase.</p>

    <div class="tool-grid" style="margin-top: 24px;">
      <section class="card" aria-label="Unit converter form">
        <div class="field">
          <label for="marla-standard"><span data-i18n="marla.std-label">Marla standard</span> <span aria-hidden="true">*</span></label>
          <select id="marla-standard" name="marla-standard" required aria-required="true" aria-describedby="standard-help">
            {MARLA_STANDARDS.map((standard) => (
              <option value={standard.id} selected={standard.id === DEFAULT_MARLA_STANDARD_ID}>{standard.label}</option>
            ))}
          </select>
          <p class="hint" id="standard-help" data-i18n="marla.std-help">
            Revenue land records use 272.25 sq ft per marla; DHA, Bahria Town and LDA schemes use 225 sq ft. Pick the one your plot follows — marla and kanal change together (20 marla = 1 kanal under both).
          </p>
        </div>
        <div class="field">
          <label for="area-value"><span data-i18n="marla.area-label">Area</span> <span aria-hidden="true">*</span></label>
          <input
            type="text"
            inputmode="decimal"
            id="area-value"
            name="area-value"
            required
            aria-required="true"
            aria-describedby="area-error area-help"
            autocomplete="off"
          />
          <p class="hint" id="area-help" data-i18n="marla.area-help">
            Enter 0 or more. Fractions are allowed — for example, 0.5 marla.
          </p>
        </div>
        <div class="field">
          <label for="from-unit"><span data-i18n="marla.from-label">From</span> <span aria-hidden="true">*</span></label>
          <select id="from-unit" name="from-unit" required aria-required="true" aria-describedby="area-error">
            {AREA_UNITS.map((unit) => (
              <option value={unit.id} selected={unit.id === 'marla'}>{unit.label}</option>
            ))}
          </select>
        </div>
        <div style="text-align: center; margin: 4px 0 16px;">
          <button type="button" class="btn-secondary" id="swap" aria-label="Swap units" style="min-height: 48px;" data-i18n="marla.swap">⇅ Swap units</button>
        </div>
        <div class="field">
          <label for="to-unit"><span data-i18n="marla.to-label">To</span> <span aria-hidden="true">*</span></label>
          <select id="to-unit" name="to-unit" required aria-required="true" aria-describedby="area-error">
            {AREA_UNITS.map((unit) => (
              <option value={unit.id} selected={unit.id === 'sqft'}>{unit.label}</option>
            ))}
          </select>
        </div>
        <p id="swap-status" role="status" style="font-size: 14px; color: var(--ink-muted);"></p>
        <div id="area-error" role="alert" class="error-box" hidden></div>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px;">
          <button type="button" class="btn-primary" id="calculate" data-i18n="ui.calculate">Calculate</button>
          <button type="button" class="btn-secondary" id="clear" data-i18n="ui.clear">Clear</button>
        </div>
      </section>

      <section class="result-card" aria-label="Conversion result">
        <div id="empty-state">
          <p><strong data-i18n="marla.empty1">Enter an area to see your conversion.</strong></p>
          <p data-i18n="marla.empty2">
            You’ll see the converted value and the same area in every listed unit.
          </p>
        </div>
        <div id="result-content" hidden>
          <div data-result-text>
            <div id="result-heading" tabindex="-1" aria-live="polite" aria-atomic="true">
              <p style="font-size: 14px; font-weight: 700; color: var(--ink-muted);" data-i18n="marla.result-label">Converted area</p>
              <p class="result-value" id="headline"></p>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 20px;">
              <div>
                <p style="font-size: 14px; color: var(--ink-muted);" data-i18n="marla.lbl-sqft">In square feet</p>
                <p id="sqft-stat" style="font-weight: 700; font-size: 20px;"></p>
              </div>
              <div>
                <p style="font-size: 14px; color: var(--ink-muted);" data-i18n="marla.lbl-factor">Conversion factor</p>
                <p id="factor-stat" style="font-weight: 700; font-size: 16px;"></p>
                <p id="factor-inverse" style="font-size: 14px; color: var(--ink-muted);"></p>
              </div>
            </div>
            <p id="echo" style="margin-top: 20px; font-size: 14px; color: var(--ink-muted);"></p>
            <p id="result-source" style="margin-top: 12px; font-size: 14px;">Source: {UNIT_SOURCE_CITATION}</p>
            <p class="notice-warning" style="margin-top: 12px;" data-i18n="marla.warn">
              Uses the marla standard you chose above (Punjab revenue by default).
              Marla sizes can differ by region and housing society; for important
              measurements, check the dimensions on your registry or the
              society's layout plan.
            </p>
          </div>
          <div class="no-print" style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px;">
            <button type="button" class="btn-secondary" data-copy-result data-i18n="ui.copy" disabled>Copy result</button>
            <button type="button" class="btn-secondary" data-print-result data-i18n="ui.print" disabled>Print</button>
          </div>
          <p data-copy-status role="status" style="font-size: 14px; margin-top: 8px;"></p>
        </div>
      </section>
    </div>

    <section id="table-section" hidden style="margin-top: 32px;">
      <h2 data-i18n="marla.table-h">The same area in every unit</h2>
      <p>{canonicalLine}</p>
      <p id="table-source" style="font-size: 14px;">Source: {UNIT_SOURCE_CITATION}</p>
      <div class="table-wrap">
        <table class="data">
          <caption id="table-caption"></caption>
          <thead>
            <tr><th scope="col" data-i18n="marla.th-unit">Unit</th><th scope="col" data-i18n="marla.th-value">Value</th></tr>
          </thead>
          <tbody id="all-units-body"></tbody>
        </table>
      </div>
    </section>

    <section class="prose-narrow" style="margin-top: 48px;">
      <h2 data-i18n="marla.how-h">How it works</h2>
      <ol>
        <li data-i18n="marla.how1">Enter the area and choose the unit it is measured in.</li>
        <li data-i18n="marla.how2">The area is converted to square feet — the common unit all conversions go through.</li>
        <li data-i18n="marla.how3">Square feet are divided by the size of the unit you want, giving your converted area — shown in every listed unit below.</li>
      </ol>
      <p>
        <span data-i18n="marla.how-formula">The conversion goes through square feet: value × square feet per From
        unit ÷ square feet per To unit.</span> {canonicalLine}.
      </p>
    </section>

    <section class="prose-narrow" style="margin-top: 40px;">
      <h2 data-i18n="marla.example-h">Worked example</h2>
      <p>
        <strong data-i18n="marla.ex-label">Example — 10 marla</strong>
      </p>
      <p>
        <span data-i18n="marla.ex-pre">10 Marla =</span> {exampleSqFt} <span data-i18n="marla.ex-mid1">Square feet;</span> {exampleSqYd} <span data-i18n="marla.ex-mid2">Square yards;</span> {exampleKanal} <span data-i18n="marla.ex-rest">Kanal. Both standards are defined in the official sources cited on this page.</span>
      </p>
    </section>

    <section class="prose-narrow faq" style="margin-top: 40px;">
      <h2 data-i18n="marla.faq-h">Frequently asked questions</h2>
      {faqs.map((faq, i) => (
        <details>
          <summary data-i18n={`marla.faq${i + 1}q`}>{faq.question}</summary>
          {/* FAQ 4's answer ends with the full source citation, so it stays
              English and carries no data-i18n; every other answer is
              translated. */}
          <p {...(i === 3 ? {} : { 'data-i18n': `marla.faq${i + 1}a` })}>{faq.answer}</p>
        </details>
      ))}
      <p><span data-i18n="fr.contact-text">Still have a question?</span> <a href="/contact/" data-i18n="nav.contact">Contact us</a>.</p>
    </section>

    <section class="prose-narrow" style="margin-top: 40px;">
      <div class="notice-info">
        <h2 data-i18n="marla.disc-h">Important — please read</h2>
        <p>
          <span data-i18n="marla.disc">Results are estimates for information only. This converter uses the
          marla standard you chose above (Punjab revenue by default),
          and other regional and housing-society definitions differ. This is not legal, surveying, or financial
          advice. Confirm important land measurements against official land
          records and, where needed, a qualified professional before acting.</span>{' '}
          <a href="/terms/" data-i18n="ui.disclaimer-link">Read the full disclaimer</a>.
        </p>
      </div>
    </section>

    <section style="margin-top: 40px;">
      <p><a href="/" data-i18n="marla.see-all">See all calculators →</a></p>
    </section>
  </div>

  <script>
    import {
      DEFAULT_MARLA_STANDARD_ID,
      areaUnitsForStandard,
      marlaStandardById,
    } from '../config/units.ts';
    import {
      MAX_AMOUNT,
      convertAreaWithUnits,
      convertAreaToAllWithUnits,
      formatNumber,
      parseDecimal,
    } from '../lib/calc.ts';

    const standardSelect = document.getElementById('marla-standard') as HTMLSelectElement;
    let currentUnits = areaUnitsForStandard(DEFAULT_MARLA_STANDARD_ID);
    let currentStandard = marlaStandardById(DEFAULT_MARLA_STANDARD_ID);

    const valueInput = document.getElementById('area-value') as HTMLInputElement;
    const fromSelect = document.getElementById('from-unit') as HTMLSelectElement;
    const toSelect = document.getElementById('to-unit') as HTMLSelectElement;
    const swapBtn = document.getElementById('swap') as HTMLButtonElement;
    const swapStatus = document.getElementById('swap-status') as HTMLParagraphElement;
    const errorBox = document.getElementById('area-error') as HTMLDivElement;
    const emptyState = document.getElementById('empty-state') as HTMLDivElement;
    const resultContent = document.getElementById('result-content') as HTMLDivElement;
    const resultCard = resultContent.closest('.result-card') as HTMLElement;
    const resultHeading = document.getElementById('result-heading') as HTMLDivElement;
    const headline = document.getElementById('headline') as HTMLParagraphElement;
    const sqftStat = document.getElementById('sqft-stat') as HTMLParagraphElement;
    const factorStat = document.getElementById('factor-stat') as HTMLParagraphElement;
    const factorInverse = document.getElementById('factor-inverse') as HTMLParagraphElement;
    const echoEl = document.getElementById('echo') as HTMLParagraphElement;
    const resultSource = document.getElementById('result-source') as HTMLParagraphElement;
    const tableSource = document.getElementById('table-source') as HTMLParagraphElement;
    const tableSection = document.getElementById('table-section') as HTMLElement;
    const tableCaption = document.getElementById('table-caption') as HTMLTableCaptionElement;
    const tableBody = document.getElementById('all-units-body') as HTMLTableSectionElement;
    const copyBtn = document.querySelector('[data-copy-result]') as HTMLButtonElement;
    const printBtn = document.querySelector('[data-print-result]') as HTMLButtonElement;
    const calculateBtn = document.getElementById('calculate') as HTMLButtonElement;
    const clearBtn = document.getElementById('clear') as HTMLButtonElement;

    function unitById(id: string) {
      return currentUnits.find((unit) => unit.id === id)!;
    }

    // Display formatting for area values: at least 2 fraction digits, up to
    // 4 (6 below 0.001, 10 below 5e-7), trimming trailing zeros past 2 dp,
    // so 2722.5 shows as 2,722.50 and 136.125 as 136.125. Zero shows as 0.
    function formatArea(value: number): string {
      if (value === 0) return '0';
      const abs = Math.abs(value);
      const maxDp = abs < 0.0000005 ? 10 : abs < 0.001 ? 6 : 4;
      return value.toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: maxDp,
      });
    }

    // Echo the entered value: commas stripped, integer part re-grouped,
    // fraction digits preserved exactly as typed — never re-rounded.
    function echoValue(raw: string): string {
      const text = raw.trim().replace(/,/g, '');
      const [intPart, fracPart] = text.split('.');
      const grouped = Number(intPart === '' ? '0' : intPart).toLocaleString('en-US');
      return fracPart === undefined ? grouped : `${grouped}.${fracPart}`;
    }

    function showError(message: string, field: HTMLElement): void {
      errorBox.textContent = message;
      errorBox.hidden = false;
      valueInput.removeAttribute('aria-invalid');
      fromSelect.removeAttribute('aria-invalid');
      toSelect.removeAttribute('aria-invalid');
      field.setAttribute('aria-invalid', 'true');
      resultContent.hidden = true;
      emptyState.hidden = false;
      tableSection.hidden = true;
      copyBtn.disabled = true;
      printBtn.disabled = true;
    }

    function clearError(): void {
      errorBox.textContent = '';
      errorBox.hidden = true;
      valueInput.removeAttribute('aria-invalid');
      fromSelect.removeAttribute('aria-invalid');
      toSelect.removeAttribute('aria-invalid');
    }

    function calculate(scrollToResult: boolean): boolean {
      const raw = valueInput.value;
      if (raw.trim() === '') {
        showError('Enter an area.', valueInput);
        return false;
      }
      const parsed = parseDecimal(raw);
      if (parsed === null) {
        showError('Enter numbers only — digits and one decimal point.', valueInput);
        return false;
      }
      if (raw.trim().startsWith('-') || Object.is(parsed, -0) || parsed < 0) {
        showError('Enter 0 or more — area cannot be negative.', valueInput);
        return false;
      }
      if (parsed > MAX_AMOUNT) {
        showError(
          `That area is too large — enter ${formatNumber(MAX_AMOUNT, 0)} or less.`,
          valueInput,
        );
        return false;
      }
      const fromUnit = unitById(fromSelect.value);
      const toUnit = unitById(toSelect.value);
      if (!fromUnit || !toUnit) {
        showError('Choose a listed unit.', fromUnit ? toSelect : fromSelect);
        return false;
      }
      let result: number;
      let all: Record<string, number>;
      try {
        // Same-unit conversion returns the input exactly, with no
        // multiply/divide round-trip.
        result = fromSelect.value === toSelect.value ? parsed : convertAreaWithUnits(parsed, fromSelect.value, toSelect.value, currentUnits);
        all = convertAreaToAllWithUnits(parsed, fromSelect.value, currentUnits);
        if (fromSelect.value === toSelect.value) all[fromSelect.value] = parsed;
      } catch {
        showError('Choose a listed unit.', fromSelect);
        return false;
      }
      clearError();
      const sqftUnit = unitById('sqft');
      const valueInSqFt = parsed * fromUnit.sqft;
      headline.textContent = `${formatArea(result)} ${toUnit.label}`;
      sqftStat.textContent = `${formatArea(valueInSqFt)} ${sqftUnit.label}`;
      const factor = fromUnit.sqft / toUnit.sqft;
      const inverse = toUnit.sqft / fromUnit.sqft;
      factorStat.textContent = `1 ${fromUnit.label} = ${formatArea(factor)} ${toUnit.label}`;
      factorInverse.textContent = `1 ${toUnit.label} = ${formatArea(inverse)} ${fromUnit.label}`;
      echoEl.textContent =
        `Based on: ${echoValue(raw)} ${fromUnit.label} → ${toUnit.label} (${currentStandard.shortLabel})` +
        ` — Source: ${currentStandard.citation}`;
      resultSource.textContent = `Source: ${currentStandard.citation}`;
      tableSource.textContent = `Source: ${currentStandard.citation}`;
      tableCaption.textContent =
        `Conversion of ${echoValue(raw)} ${fromUnit.label} into all listed units (${currentStandard.shortLabel})`;
      tableBody.innerHTML = '';
      for (const unit of currentUnits) {
        const row = document.createElement('tr');
        if (unit.id === toSelect.value) row.className = 'active-row';
        const unitCell = document.createElement('td');
        unitCell.textContent = unit.label;
        if (unit.id === toSelect.value) {
          const pill = document.createElement('span');
          pill.className = 'badge badge-info';
          pill.style.marginLeft = '8px';
          // The only static label this script writes: translated here and
          // refreshed by the __pfcAfterLang hook when the language toggles.
          pill.textContent = document.documentElement.lang === 'ur' ? 'منتخب شدہ' : 'Selected';
          unitCell.appendChild(pill);
        }
        const valueCell = document.createElement('td');
        valueCell.textContent = `${formatArea(all[unit.id])} ${unit.label}`;
        row.appendChild(unitCell);
        row.appendChild(valueCell);
        tableBody.appendChild(row);
      }
      emptyState.hidden = true;
      resultContent.hidden = false;
      tableSection.hidden = false;
      copyBtn.disabled = false;
      printBtn.disabled = false;
      if (scrollToResult) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        resultCard.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        resultHeading.focus({ preventScroll: true });
      }
      return true;
    }

    let timer: ReturnType<typeof setTimeout> | undefined;
    function scheduleCalculate(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => calculate(false), 150);
    }

    valueInput.addEventListener('input', scheduleCalculate);
    valueInput.addEventListener('change', () => calculate(false));
    fromSelect.addEventListener('change', () => calculate(false));
    toSelect.addEventListener('change', () => calculate(false));
    standardSelect.addEventListener('change', () => {
      currentStandard = marlaStandardById(standardSelect.value);
      currentUnits = areaUnitsForStandard(standardSelect.value);
      swapStatus.textContent = `Standard: ${currentStandard.shortLabel} — 1 marla = ${currentStandard.marlaSqft} sq ft, 1 kanal = ${currentStandard.kanalSqft} sq ft.`;
      calculate(false);
    });
    swapBtn.addEventListener('click', () => {
      const previousFrom = fromSelect.value;
      fromSelect.value = toSelect.value;
      toSelect.value = previousFrom;
      const fromUnit = unitById(fromSelect.value);
      const toUnit = unitById(toSelect.value);
      swapStatus.textContent = `Swapped: converting from ${fromUnit.label} to ${toUnit.label}`;
      calculate(false);
    });
    calculateBtn.addEventListener('click', () => {
      if (!calculate(true)) {
        const invalid = document.querySelector('[aria-invalid="true"]') as HTMLElement | null;
        invalid?.focus();
      }
    });
    clearBtn.addEventListener('click', () => {
      valueInput.value = '';
      standardSelect.value = DEFAULT_MARLA_STANDARD_ID;
      currentStandard = marlaStandardById(DEFAULT_MARLA_STANDARD_ID);
      currentUnits = areaUnitsForStandard(DEFAULT_MARLA_STANDARD_ID);
      fromSelect.value = 'marla';
      toSelect.value = 'sqft';
      swapStatus.textContent = '';
      clearError();
      resultContent.hidden = true;
      emptyState.hidden = false;
      tableSection.hidden = true;
      copyBtn.disabled = true;
      printBtn.disabled = true;
      valueInput.focus();
    });

    // Refresh the script-managed 'Selected' pill when the language toggles
    // (i18n.js calls this after swapping every [data-i18n] element).
    // Re-running the calculation rebuilds the units table; computed
    // results, status lines and source citations stay English.
    (window as unknown as { __pfcAfterLang?: (lang: string) => void }).__pfcAfterLang = () => {
      if (!resultContent.hidden) calculate(false);
    };
  </script>
</Layout>
