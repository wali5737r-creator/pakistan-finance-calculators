---
import Layout from '../components/Layout.astro';

const title = 'Age Calculator | Years, Months, Days & Next Birthday | Pakistan Finance Calculators';
const description =
  'Calculate your exact age in years, months and days from your date of birth, plus days until your next birthday. Free and private — nothing is stored.';

const faqs = [
  {
    question: 'How old am I?',
    answer:
      'Enter your date of birth and, if you want, a different “age at” date. The calculator counts completed years, then completed months, then remaining days, and shows the result in the result card.',
  },
  {
    question: 'How many days until my next birthday?',
    answer:
      'The result shows your next birthday — the next occurrence of your birth month and day strictly after the “age at” date — and how many days away it is. On your birthday itself, the next birthday shown is next year’s.',
  },
  {
    question: 'What happens for 29 February birthdays?',
    answer:
      'In a leap year, your birthday is 29 February. In a year without 29 February, your completed years count from 1 March, and your next birthday is shown as 1 March.',
  },
  {
    question: 'What date format should I enter?',
    answer:
      'Use the date picker to enter dates in day / month / year (DD/MM/YYYY) order — for example, 03/04/2000 means 3 April 2000. Results show dates in full, for example 15 March 1995, so there is no ambiguity.',
  },
  {
    question: 'Is my date of birth stored?',
    answer:
      'No. The calculation runs in your browser. Your date of birth is not stored, sent to a server, or included in a web address. Reloading the page clears the form.',
  },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://pakistan-finance-calculators.pages.dev/age-calculator/#webapp',
      name: 'Age Calculator',
      url: 'https://pakistan-finance-calculators.pages.dev/age-calculator/',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      description,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pakistan-finance-calculators.pages.dev/' },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Age Calculator',
          item: 'https://pakistan-finance-calculators.pages.dev/age-calculator/',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://pakistan-finance-calculators.pages.dev/age-calculator/#faq',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
});
---

<Layout title={title} description={description} slug="/age-calculator/" schema={schema}>
  <div class="container u-pt-32">
    <nav class="breadcrumb u-fs-14 u-mb-12" aria-label="Breadcrumb">
      <a href="/" data-i18n="nav.home">Home</a> / <span data-i18n="age.crumb">Age Calculator</span>
    </nav>
    <h1 data-i18n="age.h1">Age Calculator</h1>
    <p class="prose-narrow u-lede-rem" data-i18n="age.intro">
      Work out your exact age in years, months and days from your date of birth,
      on today’s date or on any date you choose — plus your total days, total
      weeks, and days until your next birthday. Your dates stay in your browser:
      your date of birth is not stored.
    </p>

    <div class="tool-grid u-mt-24">
      <section class="card" aria-label="Age calculator form">
        <div class="field">
          <label for="dob"><span data-i18n="age.dob-label">Date of birth</span> <span aria-hidden="true">*</span></label>
          <input type="date" id="dob" name="dob" required aria-required="true" aria-describedby="dob-error dob-help" autocomplete="off" />
          <p class="hint" id="dob-help" data-i18n="age.dob-help">
            Enter as day / month / year, for example 15/03/1995, using the date
            picker. 03/04/2000 means 3 April 2000.
          </p>
          <p class="notice-info" data-i18n="age.leap-note">
            Born on 29 February? In years without a 29 February, your completed
            years count from 1 March, and your next birthday is shown as
            1 March.
          </p>
        </div>
        <div class="field">
          <label for="asof" data-i18n="age.asof-label">Age at (optional)</label>
          <input type="date" id="asof" name="asof" aria-describedby="dob-error asof-help" autocomplete="off" />
          <p class="hint" id="asof-help">
            Defaults to today (Asia/Karachi). You can pick a past or future date
            to see your age on that date.
          </p>
          <p><button type="button" class="btn-secondary" id="reset-today" data-i18n="age.reset-today">Reset to today</button></p>
        </div>
        <div id="dob-error" role="alert" class="error-box" hidden></div>
        <div class="u-row-wrap-12-mt16">
          <button type="button" class="btn-primary" id="calculate" data-i18n="ui.calculate">Calculate</button>
          <button type="button" class="btn-secondary" id="clear" data-i18n="ui.clear">Clear</button>
        </div>
      </section>

      <section class="result-card" aria-label="Age result">
        <div id="empty-state">
          <p><strong data-i18n="age.empty1">Enter your date of birth to see your age.</strong></p>
          <p data-i18n="age.empty2">
            You’ll see your age in years, months and days, your total days, and
            your next birthday.
          </p>
        </div>
        <div id="result-content" hidden>
          <div data-result-text>
            <div id="result-heading" tabindex="-1" aria-live="polite" aria-atomic="true">
              <p class="u-muted-14-bold" id="result-eyebrow">Your age</p>
              <p class="result-value" id="headline"></p>
            </div>
            <p id="age-warning" class="notice-warning" role="note" hidden data-i18n="age.warning">
              This age is over 150 years. Please check the date of birth — the result is shown, but it may be a typing mistake.
            </p>
            <div class="u-grid-2-wide-mt20">
              <div>
                <p class="u-muted-14" data-i18n="age.lbl-days">Total days lived</p>
                <p class="u-fs-20-bold" id="total-days"></p>
              </div>
              <div>
                <p class="u-muted-14" data-i18n="age.lbl-weeks">Total weeks</p>
                <p class="u-fs-20-bold" id="total-weeks"></p>
              </div>
              <div>
                <p class="u-muted-14" data-i18n="age.lbl-months">Total complete months</p>
                <p class="u-fs-20-bold" id="total-months"></p>
              </div>
              <div>
                <p class="u-muted-14" data-i18n="age.lbl-next">Next birthday</p>
                <p class="u-fs-20-bold" id="next-birthday"></p>
              </div>
              <div>
                <p class="u-muted-14" data-i18n="age.lbl-born">Born</p>
                <p class="u-fs-20-bold" id="born"></p>
              </div>
            </div>
            <p class="u-muted-14 u-mt-20" id="echo"></p>
            <p class="notice-info u-mt-12" data-i18n="age.cal-note">
              Gregorian calendar. “Today” is the date in Asia/Karachi. 29 February
              birthdays count from 1 March in non-leap years.
            </p>
            <p class="u-fs-14 u-mt-12" data-i18n="age.not-stored">
              Your date of birth is not stored.
            </p>
          </div>
          <div class="no-print u-row-wrap-12-mt20">
            <button type="button" class="btn-secondary" data-copy-result data-i18n="ui.copy" disabled>Copy result</button>
            <button type="button" class="btn-secondary" data-print-result data-i18n="ui.print" disabled>Print</button>
          </div>
          <p class="u-fs-14 u-mt-8" data-copy-status role="status"></p>
        </div>
      </section>
    </div>

    <section class="prose-narrow u-mt-48">
      <h2 data-i18n="age.how-h">How it works</h2>
      <ol>
        <li data-i18n="age.how1">Enter your date of birth as day / month / year — 03/04/2000 always means 3 April 2000.</li>
        <li data-i18n="age.how2">Leave “Age at” blank for today (the date in Asia/Karachi), or pick any past or future date.</li>
        <li data-i18n="age.how3">Read your age in completed years, months and days, plus your total days, weeks, and next birthday.</li>
      </ol>
      <p data-i18n="age.how-note1">
        The years, months and days are counted by calendar borrowing: first the
        completed years, then the completed months, then the remaining days —
        not by dividing total days by 365. Total days are counted by subtracting
        the two calendar dates, so leap days are included exactly.
      </p>
      <p data-i18n="age.how-note2">
        Born on 29 February? In a year without 29 February, your completed
        years count from 1 March, and your next birthday is shown as 1 March.
        In a leap year, your birthday is 29 February itself.
      </p>
      <p data-i18n="age.how-note3">
        “Today” means the calendar date in Pakistan (Asia/Karachi) when you
        calculate. The time of day does not change the result.
      </p>
    </section>

    <section class="prose-narrow u-mt-40">
      <h2 data-i18n="age.example-h">Worked example</h2>
      <p>
        <span data-i18n="age.ex-pre">Born</span> <strong>15 March 1995</strong><span data-i18n="age.ex-mid1">, age at</span> <strong>28 October 2026</strong><span data-i18n="age.ex-mid2">:</span>
        <strong data-i18n="age.ex-age">31 years, 7 months, 13 days</strong><span data-i18n="age.ex-rest">; 11,550 days; 1,650 weeks, 0 days; 379 complete months; born on a Wednesday; next birthday 15 March 2027 (Monday), 138 days away.</span>
      </p>
    </section>

    <section class="prose-narrow faq u-mt-40">
      <h2 data-i18n="age.faq-h">Frequently asked questions</h2>
      {faqs.map((faq, i) => (
        <details>
          <summary data-i18n={`age.faq${i + 1}q`}>{faq.question}</summary>
          <p data-i18n={`age.faq${i + 1}a`}>{faq.answer}</p>
        </details>
      ))}
      <p><span data-i18n="fr.contact-text">Still have a question?</span> <a href="/contact/" data-i18n="nav.contact">Contact us</a>.</p>
    </section>

    <section class="u-mt-40">
      <p><a href="/" data-i18n="age.see-all">See all calculators →</a></p>
    </section>
  </div>

  <script>
    import { calcAge, todayInKarachi, formatNumber } from '../lib/calc.ts';

    const dobInput = document.getElementById('dob') as HTMLInputElement;
    const asofInput = document.getElementById('asof') as HTMLInputElement;
    const asofHelp = document.getElementById('asof-help') as HTMLParagraphElement;
    const errorBox = document.getElementById('dob-error') as HTMLDivElement;
    const emptyState = document.getElementById('empty-state') as HTMLDivElement;
    const resultContent = document.getElementById('result-content') as HTMLDivElement;
    const resultHeading = document.getElementById('result-heading') as HTMLDivElement;
    const resultCard = resultContent.closest('.result-card') as HTMLElement;
    const eyebrow = document.getElementById('result-eyebrow') as HTMLParagraphElement;
    const headline = document.getElementById('headline') as HTMLParagraphElement;
    const totalDaysEl = document.getElementById('total-days') as HTMLParagraphElement;
    const totalWeeksEl = document.getElementById('total-weeks') as HTMLParagraphElement;
    const totalMonthsEl = document.getElementById('total-months') as HTMLParagraphElement;
    const nextBirthdayEl = document.getElementById('next-birthday') as HTMLParagraphElement;
    const ageWarningEl = document.getElementById('age-warning') as HTMLParagraphElement;
    const bornEl = document.getElementById('born') as HTMLParagraphElement;
    const echoEl = document.getElementById('echo') as HTMLParagraphElement;
    const copyBtn = document.querySelector('[data-copy-result]') as HTMLButtonElement;
    const printBtn = document.querySelector('[data-print-result]') as HTMLButtonElement;
    const calculateBtn = document.getElementById('calculate') as HTMLButtonElement;
    const clearBtn = document.getElementById('clear') as HTMLButtonElement;
    const resetTodayBtn = document.getElementById('reset-today') as HTMLButtonElement;

    const MONTHS = [
      'January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December',
    ];

    function formatLong(iso: string): string {
      const parts = iso.split('-');
      const year = Number(parts[0]);
      const month = Number(parts[1]);
      const day = Number(parts[2]);
      return `${day} ${MONTHS[month - 1]} ${year}`;
    }

    function plural(count: number, one: string, many: string): string {
      return count === 1 ? one : many;
    }

    function describeAsOf(asOfISO: string, todayISO: string): string {
      if (asOfISO === todayISO) return ' (today, Asia/Karachi)';
      if (asOfISO > todayISO) return ' (a future date)';
      return ' (a past date)';
    }

    function refreshAsOfHelp(): void {
      const todayISO = todayInKarachi();
      const current = asofInput.value || todayISO;
      asofHelp.textContent = `Using ${formatLong(current)}${describeAsOf(current, todayISO)}. You can pick a past or future date to see your age on that date.`;
    }

    function showError(message: string, field: HTMLInputElement): void {
      errorBox.textContent = message;
      errorBox.hidden = false;
      dobInput.setAttribute('aria-invalid', 'false');
      asofInput.setAttribute('aria-invalid', 'false');
      field.setAttribute('aria-invalid', 'true');
      resultContent.hidden = true;
      emptyState.hidden = false;
      copyBtn.disabled = true;
      printBtn.disabled = true;
    }

    function clearError(): void {
      errorBox.textContent = '';
      errorBox.hidden = true;
      dobInput.removeAttribute('aria-invalid');
      asofInput.removeAttribute('aria-invalid');
    }

    function calculate(scrollToResult: boolean): boolean {
      const todayISO = todayInKarachi();
      if (!asofInput.value) asofInput.value = todayISO;
      const asOfISO = asofInput.value;
      refreshAsOfHelp();
      if (!dobInput.value) {
        showError('Enter your date of birth.', dobInput);
        return false;
      }
      let result;
      try {
        result = calcAge(dobInput.value, asOfISO);
      } catch (err) {
        const message = err instanceof Error ? err.message : 'Enter real calendar dates.';
        const field = /before/.test(message) ? asofInput : dobInput;
        showError(message, field);
        return false;
      }
      clearError();
      // The eyebrow is rewritten by this script, so it is translated here
      // (not via data-i18n) and refreshed by the __pfcAfterLang hook below
      // when the language toggles. The date itself stays in English,
      // matching the result display.
      const urdu = document.documentElement.lang === 'ur';
      eyebrow.textContent =
        asOfISO === todayISO
          ? (urdu ? 'آپ کی عمر' : 'Your age')
          : urdu
            ? `${formatLong(asOfISO)} کو آپ کی عمر`
            : `Your age on ${formatLong(asOfISO)}`;
      headline.textContent =
        `${result.years} ${plural(result.years, 'year', 'years')}, ` +
        `${result.months} ${plural(result.months, 'month', 'months')}, ` +
        `${result.days} ${plural(result.days, 'day', 'days')}`;
      totalDaysEl.textContent = formatNumber(result.totalDays, 0);
      totalWeeksEl.textContent =
        `${formatNumber(result.totalWeeks, 0)} ${plural(result.totalWeeks, 'week', 'weeks')}, ` +
        `${result.remainingDays} ${plural(result.remainingDays, 'day', 'days')}`;
      totalMonthsEl.textContent = formatNumber(result.totalMonths, 0);
      nextBirthdayEl.textContent =
        `${formatLong(result.nextBirthday)} — in ${result.daysUntilNextBirthday} ` +
        `${plural(result.daysUntilNextBirthday, 'day', 'days')}`;
      bornEl.textContent = `${result.dayOfWeekBorn}, ${formatLong(dobInput.value)}`;
      ageWarningEl.hidden = !result.implausibleAgeWarning;
      echoEl.textContent =
        `Based on: born ${formatLong(dobInput.value)} · age at ${formatLong(asOfISO)}` +
        describeAsOf(asOfISO, todayISO);
      emptyState.hidden = true;
      resultContent.hidden = false;
      copyBtn.disabled = false;
      printBtn.disabled = false;
      if (scrollToResult) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        resultCard.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        resultHeading.focus({ preventScroll: true });
      }
      return true;
    }

    let timer: ReturnType<typeof setTimeout> | undefined;
    function scheduleCalculate(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => calculate(false), 150);
    }

    dobInput.addEventListener('input', scheduleCalculate);
    dobInput.addEventListener('change', () => calculate(false));
    asofInput.addEventListener('input', scheduleCalculate);
    asofInput.addEventListener('change', () => calculate(false));
    calculateBtn.addEventListener('click', () => {
      if (!calculate(true)) {
        const invalid = document.querySelector('[aria-invalid="true"]') as HTMLElement | null;
        invalid?.focus();
      }
    });
    resetTodayBtn.addEventListener('click', () => {
      asofInput.value = todayInKarachi();
      calculate(false);
    });
    clearBtn.addEventListener('click', () => {
      dobInput.value = '';
      asofInput.value = todayInKarachi();
      clearError();
      resultContent.hidden = true;
      emptyState.hidden = false;
      copyBtn.disabled = true;
      printBtn.disabled = true;
      refreshAsOfHelp();
      dobInput.focus();
    });

    // The "age at" help line is rebuilt from the live date on every
    // calculation, so it stays English (dynamic result text) and carries
    // no data-i18n; only the eyebrow above is a script-managed label.

    // Refresh the script-managed eyebrow when the language toggles (i18n.js
    // calls this after swapping every [data-i18n] element). Re-running the
    // calculation restores the eyebrow; computed results stay English.
    (window as unknown as { __pfcAfterLang?: (lang: string) => void }).__pfcAfterLang = () => {
      if (!resultContent.hidden) calculate(false);
    };

    // Default the "age at" date to today in Asia/Karachi, evaluated in the
    // browser at load time — never baked into the static HTML.
    asofInput.value = todayInKarachi();
    refreshAsOfHelp();
  </script>
</Layout>
