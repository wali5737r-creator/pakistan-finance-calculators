---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  slug: string;
  h1?: string;
  schema?: string;
  noindex?: boolean;
}

const { title, description, slug, schema, noindex = false } = Astro.props;
// Canonical URL for this page, using the live domain.
const canonical = `https://pakistan-finance-calculators.pages.dev${slug}`;
const tools = [
  { href: '/salary-income-tax-calculator/', label: 'Salary Tax' },
  { href: '/emi-loan-calculator/', label: 'EMI Calculator' },
  { href: '/zakat-calculator/', label: 'Zakat Calculator' },
  { href: '/currency-converter/', label: 'Currency Converter' },
  { href: '/gold-price-calculator/', label: 'Gold Price' },
  { href: '/percentage-calculator/', label: 'Percentage' },
  { href: '/age-calculator/', label: 'Age Calculator' },
  { href: '/unit-marla-converter/', label: 'Marla Converter' },
  { href: '/fuel-cost-calculator/', label: 'Fuel Cost' },
  { href: '/compound-interest-calculator/', label: 'Compound Interest' },
  { href: '/loan-eligibility-calculator/', label: 'Loan Eligibility' },
  { href: '/inflation-calculator/', label: 'Inflation' },
  { href: '/budget-planner-calculator/', label: 'Budget Planner' },
  { href: '/debt-payoff-calculator/', label: 'Debt Payoff' },
  { href: '/fixed-deposit-calculator/', label: 'Fixed Deposit' },
  { href: '/loan-comparison-calculator/', label: 'Loan Comparison' },
  { href: '/goal-savings-calculator/', label: 'Goal Savings' },
  { href: '/electricity-bill-calculator/', label: 'Electricity Bill' },
  { href: '/gas-bill-calculator/', label: 'Gas Bill' },
  { href: '/freelancer-tax-calculator/', label: 'Freelancer Tax' },
  { href: '/solar-size-payback-calculator/', label: 'Solar Payback' },
  { href: '/pension-eobi-calculator/', label: 'Pension / EOBI' },
  { href: '/national-savings-calculator/', label: 'National Savings' },
  { href: '/gst-calculator/', label: 'GST Calculator' },
  { href: '/car-loan-calculator/', label: 'Car Loan' },
  { href: '/home-loan-calculator/', label: 'Home Loan' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="d416257cee9fdd3f" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://pakistan-finance-calculators.pages.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content="Pakistan Finance Calculators" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://pakistan-finance-calculators.pages.dev/og-image.png" />
    <meta name="theme-color" content="#0c5c44" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {schema && <script type="application/ld+json" set:html={schema} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="container site-header-bar">
        <a class="brand-mark" href="/">
          <span class="brand-badge" aria-hidden="true">Rs</span>
          <span>Pakistan Finance Calculators</span>
        </a>
        <nav class="main-nav" aria-label="Main">
          <a href="/">Home</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
      <nav class="tool-nav" aria-label="Calculators">
        <div class="container tool-nav-scroll">
          {tools.map((t) => (
            <a href={t.href}>{t.label}</a>
          ))}
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p class="footer-brand">Pakistan Finance Calculators</p>
          <p style="font-size:14px; max-width:480px; margin:0;">
            Free calculators for Pakistan. Results are estimates for information
            only — not tax, financial, or religious advice. Calculations run in
            your browser; nothing you enter is stored or sent to a server.
          </p>
        </div>
        <nav aria-label="Calculators">
          <p class="footer-heading">Calculators</p>
          <ul class="footer-links">
            {tools.map((t) => (
              <li><a href={t.href}>{t.label}</a></li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Footer">
          <p class="footer-heading">Site</p>
          <ul class="footer-links">
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/privacy/">Privacy Policy</a></li>
            <li><a href="/terms/">Terms &amp; Disclaimer</a></li>
          </ul>
        </nav>
      </div>
      <div class="container footer-bottom">
        <span>© 2026 Pakistan Finance Calculators</span>
        <span>Free · No sign-up · Private</span>
      </div>
    </footer>
    <!-- External script (public/js/shared.js) so CSP script-src needs no 'unsafe-inline'. -->
    <script src="/js/shared.js" defer></script>
  </body>
</html>
