# Cache-Control (2026-11-13, audit P2 performance). Cloudflare Pages serves
# every static file with `public, max-age=0, must-revalidate` by default, so
# repeat visits re-downloaded every script, font and image. These rules fix
# that. Specific rules come first: Cloudflare Pages applies the first rule
# that matches a path for a given header.
#
# Hashed Astro bundles: the filenames contain a content hash
# (e.g. /_astro/calc.BSFSJBk3.js), so a new build gets a new URL and the old
# file can never go stale. Safe to cache for a year and mark immutable.
# HTML pages and /api/* are DELIBERATELY absent here: pages must stay fresh
# (rates, lastmod, new tools) and the API Functions set their own headers
# (/api/rates is no-store). Do not add a Cache-Control to the /* rule below.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed public files that change on deploy (i18n.js carries 2,011 Urdu
# keys and grows every phase; shared.js, the font and og-image.png change
# too). A year-long cache here would serve stale files after a deploy, so
# these get 1 hour only — repeat visits within the hour are fast, and a new
# deploy reaches every user within an hour at most (ETag revalidation still
# applies after expiry). NOT immutable, NOT max-age=31536000.
/js/*
  Cache-Control: public, max-age=3600, must-revalidate
/fonts/*
  Cache-Control: public, max-age=3600, must-revalidate
/og-image.png
  Cache-Control: public, max-age=3600, must-revalidate
/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://s3.tradingview.com; style-src 'self'; img-src 'self' data: https://s3.tradingview.com https://*.tradingview.com; connect-src 'self' https://*.tradingview.com; frame-src https://www.tradingview.com https://www.tradingview-widget.com; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  # NOTE (2026-11-13): 'unsafe-inline' was removed from script-src. Every
  # executable script is now an external file: tool calculators are bundled
  # by Astro into /_astro/*.js, the shared copy/print handler lives in
  # /js/shared.js, and the GST / National Savings pages pass their data via
  # <script type="application/json"> data blocks (data blocks are not
  # executed, so CSP script-src does not apply to them — same as the
  # application/ld+json schema blocks). The TradingView widget on the Gold
  # page is still allowed: it is loaded by creating a <script> element with
  # src https://s3.tradingview.com/..., which the host source permits.
  # frame-src MUST include https://www.tradingview-widget.com (added
  # 2026-11-13): the embed script's widgetHost is
  # https://www.tradingview-widget.com and the widget iframe loads from
  # https://www.tradingview-widget.com/embed-widget/single-quote/ — NOT
  # from www.tradingview.com. Before this fix frame-src allowed only
  # www.tradingview.com (since the initial commit), so the iframe was
  # blocked by CSP and the widget rendered blank from the day it was
  # added (2026-10-29); TradingView's own fallback rewrites the iframe
  # to https://s.tradingview.com, which frame-src also did not allow,
  # so the fallback failed too. The widget script makes no fetch/XHR/
  # WebSocket calls from our page, so connect-src needs no change.
  # Known cosmetic caveat: the embed script also injects a <style>
  # element for the copyright-attribution text, which style-src 'self'
  # blocks — the attribution link itself still shows, only its
  # widget-supplied styling is lost. Guarded by tests/csp.test.ts.
  # style-src 'unsafe-inline' was REMOVED 2026-11-13 (second half of the
  # CSP audit item): all 729 inline style attributes across src/
  # became .u-* utility classes in src/styles/global.css (91 canonical
  # values, 80 classes; the 2 dynamic zakat bar widths and the 1
  # conditional currency headline use CSSOM setProperty / class toggles,
  # which style-src does not block), and the 22 inline <style> blocks
  # (Astro inlines scoped component styles) became external
  # src/styles/pages/<slug>.css files, each rule prefixed with a
  # page-unique .pg-<slug> class so today's scoping is preserved.
  # Known visible change: JS-generated `tr.total-row` rows in breakdown
  # tables now match their page rule and render bold, where the old
  # scoped rule never matched them — that is the intended look.
  # Guarded by tests/csp.test.ts: a future inline style fails CI.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
